<view class="container">
  <!-- 综合能力雷达图卡片 -->
  <view class="card radar-card">
    <view class="card-title">我的综合能力</view>

    <!-- 有评分数据：展示雷达图与综合平均分 -->
    <view wx:if="{{hasScores}}" class="radar-wrapper">
      <radar-chart
        scores="{{radarScores}}"
        dimensions="{{dimensions}}"
        max-value="{{10}}"
        theme-color="#8B5CF6"
      />
      <view class="overall-score">
        <text class="score-label">综合平均分</text>
        <text class="score-value">{{overallAvg}}</text>
      </view>
    </view>

    <!-- 无评分数据：展示空状态 -->
    <view wx:else class="radar-empty-state">
      <text class="empty-icon">📊</text>
      <text class="empty-text">{{loading ? '加载中...' : '暂无评分数据'}}</text>
      <text class="empty-sub-text">完成训练评分后展示</text>
    </view>
  </view>

  <!-- 训练记录列表 -->
  <view class="card">
    <view class="card-title">训练记录 ({{trainings.length}})</view>

    <view wx:if="{{trainings.length > 0}}" class="training-list">
      <view
        wx:for="{{trainings}}"
        wx:key="id"
        class="training-item"
        bindtap="goToDetail"
        data-id="{{item.training.id}}"
        hover-class="training-item-hover"
      >
        <view class="training-header">
          <text class="training-title">{{item.training.title}}</text>
          <text wx:if="{{item.myScore.avgScore}}" class="training-score">{{item.myScore.avgScore}}</text>
        </view>
        <view class="training-info">
          <text class="info-item">📅 {{item.training.formattedTime || item.training.startTime || '未知时间'}}</text>
          <text class="info-item">👨‍🏫 {{item.training.coachName || '未知教练'}}</text>
        </view>
        <view wx:if="{{item.myScore.coachComment}}" class="coach-comment">
          💬 {{item.myScore.coachComment}}
        </view>
      </view>
    </view>

    <view wx:else class="empty-tip">
      {{loading ? '加载中...' : '暂无训练记录'}}
    </view>
  </view>
</view>
