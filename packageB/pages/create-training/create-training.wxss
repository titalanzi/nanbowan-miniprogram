.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.required {
  color: #EF4444;
  margin-left: 4rpx;
}

.picker {
  padding: 24rpx 28rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #374151;
  transition: all 0.2s ease;
}

.picker-placeholder {
  color: #9CA3AF;
}

.picker:active {
  border-color: #0052D9;
  background: #F2F6FF;
}

.description-card {
  overflow: visible;
  transition: none;
}

.description-card:active {
  transform: none;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #E4E7EC;
  border-radius: 20rpx;
  font-size: 30rpx;
  background: #F9FAFB;
  box-sizing: border-box;
  line-height: 1.5;
}

.form-textarea:focus {
  border-color: #0052D9;
  background: white;
}

/* 评分维度展示 */
.dim-section {
  margin-bottom: 20rpx;
}

.dim-section-label {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.dim-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dim-tag {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #ECF2FE, #FFFFFF);
  color: #0052D9;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: 2rpx solid #D4E2FB;
}

.dim-tip {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
}

/* 分组设置 */
.group-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.group-input {
  flex: 1;
}

.group-remove {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FEF2F2;
  border-radius: 50%;
  flex-shrink: 0;
}

.add-group-btn {
  margin-top: 8rpx;
  background: transparent !important;
  border-color: #0052D9 !important;
  color: #0052D9 !important;
}

/* 提交按钮 */
.submit-btn-wrapper {
  padding: 32rpx 0 64rpx;
}
