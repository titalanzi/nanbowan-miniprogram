.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 28rpx;
}

.required {
  color: #EF4444;
  margin-left: 4rpx;
}

.picker {
  padding: 24rpx 28rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #374151;
  transition: all 0.2s ease;
}

.picker:active {
  border-color: #FF6B35;
  background: #FFF7ED;
}

.description-card {
  overflow: visible;
  transition: none;
}

.description-card:active {
  transform: none;
}

.form-textarea {
  width: 100%;
  height: 200rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid #E4E7EC;
  border-radius: 20rpx;
  font-size: 30rpx;
  background: #F9FAFB;
  box-sizing: border-box;
  line-height: 1.5;
}

.form-textarea:focus {
  border-color: #FF6B35;
  background: white;
}

/* 评分维度展示 */
.dim-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.dim-tag {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #F3E8FF, #FFFFFF);
  color: #8B5CF6;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: 2rpx solid #E9D5FF;
}

.dim-tip {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn-wrapper {
  padding: 32rpx 0 64rpx;
}

.submit-btn {
  width: 100%;
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  color: white;
  border: none;
  border-radius: 48rpx;
  padding: 28rpx 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
  letter-spacing: 4rpx;
}

.submit-btn[disabled] {
  opacity: 0.6;
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  color: white;
}
