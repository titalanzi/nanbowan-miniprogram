/* 顶部队训卡片：紫色左边框 */
.training-card {
  border-left: 8rpx solid #8B5CF6;
}

.training-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.training-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  flex: 1;
}

.training-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.training-desc {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.6;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2F4F7;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 20rpx;
}

/* 教练信息 */
.coach-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coach-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F3F4F6;
}

.coach-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.coach-name {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 500;
}

/* 签到列表 */
.attendee-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.attendee-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

.attendee-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E5E7EB;
}

.attendee-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.attendee-name {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 500;
}

.attendee-time {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 雷达图区域：居中 */
.radar-card {
  background: linear-gradient(135deg, #FAF5FF, #FFFFFF);
  border: 2rpx solid #8B5CF6;
}

.radar-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

/* 评分详情卡片 */
.score-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-item {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #8B5CF6;
}

.score-item-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.score-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E5E7EB;
}

.score-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

/* 评分维度用小标签展示 */
.dimension-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.dimension-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: white;
  border-radius: 20rpx;
  border: 1rpx solid #E5E7EB;
}

.dim-label {
  font-size: 22rpx;
  color: #6B7280;
}

.dim-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #8B5CF6;
}

.score-summary {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.summary-item {
  font-size: 26rpx;
  color: #6B7280;
}

.summary-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B35;
}

.coach-comment {
  background: white;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.comment-label {
  font-size: 24rpx;
  color: #8B5CF6;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.5;
}

/* 互评列表 */
.peer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.peer-item {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 20rpx;
}

.peer-target {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.peer-target-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.peer-target-label {
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 4rpx 12rpx;
  background: white;
  border-radius: 16rpx;
}

.peer-comments {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.peer-comment {
  background: white;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.5;
}

.comment-from {
  font-weight: 600;
  color: #FF6B35;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

.footer-wrapper {
  padding: 28rpx 0 48rpx;
  display: flex;
  gap: 24rpx;
  flex-direction: column;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  color: white;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: white;
  color: #FF6B35;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 30rpx;
  border: 2rpx solid #FF6B35;
}

.btn-secondary::after {
  border: none;
}

.btn-outline {
  background: white;
  color: #6B7280;
  font-weight: 500;
  border-radius: 48rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  border: 2rpx solid #E5E7EB;
}

.btn-outline::after {
  border: none;
}

/* 已加入提示 */
.joined-tip {
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #10B981;
  font-weight: 600;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
}

.modal-content {
  background: white;
  border-radius: 32rpx;
  width: 100%;
  max-width: 600rpx;
  overflow: hidden;
  animation: modalPopIn 0.3s ease;
}

@keyframes modalPopIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.modal-close {
  font-size: 36rpx;
  color: #9CA3AF;
  padding: 8rpx;
  line-height: 1;
}

.modal-body {
  padding: 16rpx 32rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.modal-desc {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 28rpx;
}

.avatar-section {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.avatar-btn {
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #F3F4F6;
  border: 4rpx solid #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 100%;
}

.avatar-placeholder-icon {
  font-size: 40rpx;
}

.avatar-placeholder-text {
  font-size: 20rpx;
  color: #9CA3AF;
}

.uploading-tip {
  font-size: 22rpx;
  color: #9CA3AF;
}

.name-input {
  width: 100%;
  height: 88rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #111827;
  padding: 0 24rpx;
  box-sizing: border-box;
  text-align: center;
  margin-bottom: 28rpx;
}

.name-input:focus {
  border-color: #FF6B35;
  background: white;
}

.input-placeholder {
  color: #D1D5DB;
}

.join-modal-btn {
  width: 100%;
}

/* 教练信息区操作 */
.coach-actions {
  margin-left: auto;
}

.coach-change-btn {
  font-size: 26rpx;
  color: #8B5CF6;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: #F5F3FF;
  border-radius: 20rpx;
}

/* 签到列表教练标识 */
.attendee-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.coach-badge {
  font-size: 20rpx;
  color: white;
  background: linear-gradient(135deg, #8B5CF6, #6366F1);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

/* 指定教练弹窗 */
.coach-picker-content {
  max-height: 80vh;
}

.coach-picker-body {
  padding: 16rpx 32rpx 32rpx;
}

.coach-picker-tip {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
}

.coach-picker-list {
  max-height: 600rpx;
}

.coach-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  transition: all 0.15s ease;
}

.coach-option:active {
  background: #F9FAFB;
}

.coach-option.selected {
  background: #F5F3FF;
}

.coach-option-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E5E7EB;
}

.coach-option-name {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
  font-weight: 500;
}

.coach-option-current {
  font-size: 24rpx;
  color: #8B5CF6;
  font-weight: 600;
  padding: 6rpx 16rpx;
  background: white;
  border-radius: 16rpx;
}
