/* 顶部队训卡片：紫色左边框 */
.training-card {
  border-left: 8rpx solid #0052D9;
}

.training-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.training-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  flex: 1;
}

.training-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.training-desc {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.6;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2F4F7;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.manage-link {
  font-size: 28rpx;
  font-weight: 500;
  color: #0052D9;
  padding: 8rpx 20rpx;
  background: #ECF2FE;
  border-radius: 20rpx;
}

.manage-link:active {
  background: #D4E2FB;
}

/* 教练信息 */
.coach-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.coach-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F3F4F6;
}

.coach-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.coach-name {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 500;
}

/* 签到列表 */
.attendee-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.group-section {
  background: #F9FAFB;
  border-radius: 16rpx;
  overflow: hidden;
}

.group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #0052D9, #366EF4);
}

.group-name {
  font-size: 30rpx;
  font-weight: 600;
  color: white;
}

.group-count {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.count-number {
  font-size: 28rpx;
  font-weight: 700;
  color: white;
}

.count-unit {
  font-size: 24rpx;
}

.gender-count {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 8rpx;
}

.gender-icon-mini {
  width: 28rpx;
  height: 28rpx;
}

.gender-num {
  font-size: 24rpx;
  font-weight: 600;
  color: white;
}

.attendee-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 20rpx;
  gap: 16rpx;
}

.attendee-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: white;
  border-radius: 16rpx;
  min-width: 100rpx;
  flex: 1;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.attendee-avatar-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  padding: 6rpx;
  background: #E5E7EB;
  box-sizing: border-box;
}

.attendee-avatar-wrap.gender-male {
  background: #3B82F6;
}

.attendee-avatar-wrap.gender-female {
  background: #EC4899;
}

.attendee-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #FFFFFF;
  overflow: hidden;
}

.attendee-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.attendee-name {
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 500;
  text-align: center;
}

.gender-icon-small {
  width: 28rpx;
  height: 28rpx;
}

/* 移除成员按钮 */
.remove-btn {
  font-size: 24rpx;
  color: #EF4444;
  padding: 8rpx 20rpx;
  border: 1rpx solid #FECACA;
  border-radius: 24rpx;
  background: #FEF2F2;
  font-weight: 500;
  transition: all 0.15s ease;
}

.remove-btn:active {
  background: #FEE2E2;
  transform: scale(0.95);
}

/* 雷达图区域：居中 */
.radar-card {
  background: linear-gradient(135deg, #F2F6FF, #FFFFFF);
  border: 2rpx solid #0052D9;
}

.radar-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

/* 评分详情卡片 */
.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 16rpx;
  display: block;
}

.group-score-section {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.group-score-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-score-item {
  background: #ECF2FE;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #D4E2FB;
}

.group-score-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.group-score-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.group-score-avg {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.group-score-avg .avg-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #0052D9;
}

.group-score-avg .avg-label {
  font-size: 24rpx;
  color: #366EF4;
}

.group-score-avg.no-score .avg-label {
  color: #9CA3AF;
}

.score-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-item {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #0052D9;
}

.score-item-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.score-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E5E7EB;
}

.score-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

/* 评分维度用小标签展示 */
.dimension-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.dimension-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background: white;
  border-radius: 20rpx;
  border: 1rpx solid #E5E7EB;
}

.dim-label {
  font-size: 22rpx;
  color: #6B7280;
}

.dim-value {
  font-size: 26rpx;
  font-weight: 700;
  color: #0052D9;
}

.score-summary {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.summary-item {
  font-size: 26rpx;
  color: #6B7280;
}

.summary-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #0052D9;
}

.coach-comment {
  background: white;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.comment-label {
  font-size: 24rpx;
  color: #0052D9;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.comment-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.5;
}

/* 互评列表 */
.peer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.peer-item {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 20rpx;
}

.peer-target {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.peer-target-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.peer-target-label {
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 4rpx 12rpx;
  background: white;
  border-radius: 16rpx;
}

.peer-comments {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.peer-comment {
  background: white;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.5;
}

.comment-from {
  font-weight: 600;
  color: #0052D9;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

.footer-wrapper {
  padding: 28rpx 0 48rpx;
  display: flex;
  gap: 24rpx;
  flex-direction: column;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #0052D9, #366EF4);
  color: white;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: white;
  color: #0052D9;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 30rpx;
  border: 2rpx solid #0052D9;
}

.btn-secondary::after {
  border: none;
}

.btn-outline {
  background: white;
  color: #6B7280;
  font-weight: 500;
  border-radius: 48rpx;
  padding: 26rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  border: 2rpx solid #E5E7EB;
}

.btn-outline::after {
  border: none;
}

/* 已加入提示 */
.joined-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #10B981;
  font-weight: 600;
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
}

.modal-content {
  background: white;
  border-radius: 32rpx;
  width: 100%;
  max-width: 600rpx;
  overflow: hidden;
  animation: modalPopIn 0.3s ease;
}

@keyframes modalPopIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.modal-close {
  font-size: 36rpx;
  color: #9CA3AF;
  padding: 8rpx;
  line-height: 1;
}

.modal-body {
  padding: 16rpx 32rpx 24rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx 32rpx;
  border-top: 1rpx solid #F2F4F7;
}

.modal-footer button {
  flex: 1;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #475467;
  margin-bottom: 12rpx;
  font-weight: 500;
}

/* 头像选择区域 */
.avatar-pick-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #0052D9;
  box-shadow: 0 8rpx 20rpx rgba(0, 82, 217, 0.18);
}

.avatar-placeholder-icon {
  font-size: 64rpx;
  color: #98A2B3;
  font-weight: 300;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-pick-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  width: 100%;
}

.wx-btn {
  margin: 0;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #0052D9, #366EF4);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 82, 217, 0.28);
  transition: all 0.15s ease;
}

.wx-btn::after {
  border: none;
}

.wx-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.album-link {
  font-size: 26rpx;
  color: #0052D9;
  font-weight: 500;
  padding: 8rpx 0;
}

.album-link:active {
  opacity: 0.6;
}

.avatar-tip {
  font-size: 24rpx;
  color: #98A2B3;
  text-align: center;
}

/* 教练信息区操作 */
.coach-actions {
  margin-left: auto;
}

.coach-change-btn {
  font-size: 26rpx;
  color: #0052D9;
  font-weight: 500;
  padding: 8rpx 20rpx;
  background: #ECF2FE;
  border-radius: 20rpx;
}

/* 签到列表教练标识 */
.attendee-name-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.coach-badge {
  font-size: 20rpx;
  color: white;
  background: linear-gradient(135deg, #0052D9, #366EF4);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

/* 指定教练弹窗 */
.coach-picker-content {
  max-height: 80vh;
}

.coach-picker-body {
  padding: 16rpx 32rpx 32rpx;
}

.coach-picker-tip {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
}

.coach-picker-list {
  max-height: 600rpx;
}

.coach-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  transition: all 0.15s ease;
}

.coach-option:active {
  background: #F9FAFB;
}

.coach-option.selected {
  background: #ECF2FE;
}

.coach-option-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E5E7EB;
}

.coach-option-name {
  flex: 1;
  font-size: 30rpx;
  color: #111827;
  font-weight: 500;
}

.coach-option-current {
  font-size: 24rpx;
  color: #0052D9;
  font-weight: 600;
  padding: 6rpx 16rpx;
  background: white;
  border-radius: 16rpx;
}

/* 签到列表操作按钮 */
.attendee-actions {
  display: flex;
  gap: 12rpx;
}

.manage-btn {
  font-size: 24rpx;
  color: #0052D9;
  padding: 8rpx 20rpx;
  border: 1rpx solid #D4E2FB;
  border-radius: 24rpx;
  background: #ECF2FE;
  font-weight: 500;
  transition: all 0.15s ease;
}

.manage-btn:active {
  background: #ECF2FE;
  transform: scale(0.95);
}

/* 成员管理弹窗 */
.manage-user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.manage-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E5E7EB;
}

.manage-user-detail {
  flex: 1;
}

.manage-user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 8rpx;
}

.manage-user-role {
  display: flex;
  gap: 8rpx;
}

.role-tag.coach {
  background: linear-gradient(135deg, #0052D9, #366EF4);
  color: white;
}

.manage-action-row {
  display: flex;
  gap: 16rpx;
}

.manage-action-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.15s ease;
}

.manage-action-btn.danger {
  background: #FEF2F2;
  color: #EF4444;
  border: 1rpx solid #FECACA;
}

.manage-action-btn.danger:active {
  background: #FEE2E2;
}

.manage-action-btn.primary {
  background: #ECF2FE;
  color: #0052D9;
  border: 1rpx solid #D4E2FB;
}

.manage-action-btn.primary:active {
  background: #FEE2E2;
  transform: scale(0.98);
}

/* 加入弹窗：性别选择 */
.required-mark {
  color: #EF4444;
  margin-left: 4rpx;
}

.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
}

.gender-option.active {
  background: #ECF2FE;
  border-color: #0052D9;
}

.gender-icon {
  width: 40rpx;
  height: 40rpx;
}

.gender-option text {
  font-size: 28rpx;
  color: #6B7280;
}

.gender-option.active text {
  color: #0052D9;
  font-weight: 600;
}

/* 加入弹窗：分组选择 */
.group-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.group-option {
  padding: 16rpx 32rpx;
  background: #F3F4F6;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  font-size: 28rpx;
  color: #6B7280;
  transition: all 0.2s ease;
}

.group-option.active {
  background: #ECF2FE;
  border-color: #0052D9;
  color: #0052D9;
  font-weight: 600;
}

/* 加入弹窗：角色选择（单选） */
.role-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.role-option.active {
  background: #ECF2FE;
  border-color: #0052D9;
}

.role-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.role-option.active .role-radio {
  border-color: #0052D9;
}

.radio-inner {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: transparent;
  transition: all 0.2s ease;
}

.radio-inner.checked {
  background: #0052D9;
}

.role-text {
  font-size: 30rpx;
  color: #374151;
  flex: 1;
}

.role-option.active .role-text {
  color: #0052D9;
  font-weight: 600;
}

.role-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.role-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 0;
  margin: 8rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #E5E7EB;
}

.divider-text {
  font-size: 24rpx;
  color: #9CA3AF;
  white-space: nowrap;
}

/* 加入弹窗：教练身份切换 */
.coach-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.coach-toggle-text {
  font-size: 28rpx;
  color: #374151;
}
