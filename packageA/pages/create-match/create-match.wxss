.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.add-btn {
  font-size: 28rpx;
  color: #0052D9;
  font-weight: 600;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, #ECF2FE, #FFFFFF);
  border-radius: 16rpx;
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #9CA3AF;
  font-size: 30rpx;
  font-weight: 500;
}

.picker {
  padding: 24rpx 28rpx;
  background: #FAFAFA;
  border: 2rpx solid #E5E7EB;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #374151;
  transition: all 0.3s ease;
}

.picker:focus {
  border-color: #0052D9;
  background: white;
  box-shadow: 0 0 0 6rpx rgba(0, 82, 217, 0.1);
}

.group-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.group-item {
  background: linear-gradient(135deg, #F9FAFB, #FFFFFF);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.group-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.group-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.group-color {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.group-detail {
  display: flex;
  flex-direction: column;
}

.group-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.group-count {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
}

.group-actions {
  display: flex;
  gap: 24rpx;
}

.action-text {
  font-size: 26rpx;
  color: #3B82F6;
  font-weight: 600;
}

.action-text.delete {
  color: #EF4444;
}

.stat-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #F9FAFB, #FFFFFF);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.stat-color {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.stat-name {
  font-size: 30rpx;
  color: #374151;
  font-weight: 600;
}

.delete-stat {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  background: linear-gradient(135deg, #EF4444, #DC2626);
  color: white;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.3);
}

.create-btn-wrapper {
  padding: 48rpx 0;
}

.create-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.create-btn.btn-loading {
  opacity: 0.85;
  pointer-events: none;
}

.btn-loading-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.rotating {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.member-modal {
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 86%;
}

.member-modal .modal-header {
  flex-shrink: 0;
}

.member-modal .picker-hint {
  flex-shrink: 0;
}

.member-modal .modal-body {
  flex: 1;
  max-height: none;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
}

.member-modal .modal-footer {
  flex-shrink: 0;
}

.member-modal .form-item {
  box-sizing: border-box;
}

.member-modal .picker-btn {
  width: 100%;
  box-sizing: border-box;
}

.member-modal .color-options {
  flex-wrap: wrap;
}

.add-member-btn {
  background: linear-gradient(135deg, #ECF2FE, #FFFFFF);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  color: #0052D9;
  margin-bottom: 28rpx;
  font-weight: 600;
  border: 2rpx dashed #0052D9;
}

.member-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
  transition: all 0.3s ease;
}

.member-item:last-child {
  border-bottom: none;
}

.member-item:hover {
  background: #F9FAFB;
}

.member-info {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.member-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.member-gender-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.9;
}

.member-number {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
}

.delete-text {
  font-size: 28rpx;
  color: #EF4444;
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: #FEF2F2;
  border-radius: 12rpx;
}

.color-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-option {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 5rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.color-option.selected {
  border-color: #111827;
  transform: scale(1.1);
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.25);
}

.gender-options {
  display: flex;
  gap: 20rpx;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 20rpx;
  background: #F9FAFB;
  border-radius: 20rpx;
  border: 3rpx solid #E5E7EB;
  transition: all 0.3s ease;
}

.gender-option.selected {
  border-color: #0052D9;
  background: #ECF2FE;
}

.gender-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 12rpx;
}

.gender-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.gender-option.selected .gender-text {
  color: #0052D9;
  font-weight: 700;
}

/* 模式切换 */
.mode-tabs {
  display: flex;
  background: #F3F4F6;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.mode-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 16rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #6B7280;
  transition: all 0.3s ease;
}

.mode-tab.active {
  background: linear-gradient(135deg, #0052D9, #366EF4);
  color: white;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0, 82, 217, 0.25);
}

.mode-section-header {
  margin-bottom: 20rpx;
}

/* 步骤进度条 */
.step-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 28rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #9CA3AF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.step-item.active .step-num {
  background: linear-gradient(135deg, #0052D9, #366EF4);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.3);
}

.step-label {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 500;
}

.step-item.active .step-label {
  color: #0052D9;
  font-weight: 600;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: #E5E7EB;
  margin: 0 8rpx;
  border-radius: 2rpx;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
}

.step-line.active {
  background: linear-gradient(90deg, #0052D9, #366EF4);
}

/* 步骤内容 */
.random-step-content {
  min-height: 400rpx;
}

.step-desc {
  font-size: 26rpx;
  color: #6B7280;
  text-align: center;
  margin-bottom: 24rpx;
}

/* 添加队员按钮 */
.add-player-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #0052D9, #366EF4);
  color: white;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 82, 217, 0.3);
  transition: all 0.2s ease;
}

.add-player-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 82, 217, 0.2);
}

/* 队员列表 */
.player-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.player-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: white;
  border-radius: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

/* 等级标识：左侧色条（替代整圈彩边，减少视觉刺激） */
.player-item::before,
.import-player-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--level-color, #E5E7EB);
}

.player-item:active {
  transform: scale(0.98);
}

.player-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.player-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-gender-icon {
  width: 36rpx;
  height: 36rpx;
}

.player-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

.player-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #FEE2E2;
}

/* 等级输入框：靠在删除按钮左边（右侧对齐，紧贴删除按钮） */
.player-level-slot {
  margin-left: auto;
  margin-right: 16rpx;
}

.player-stats {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  flex-wrap: wrap;
}

/* 步骤按钮组 */
.step-btn-group {
  padding-top: 16rpx;
}

.step-btn-group.two-btn {
  display: flex;
  gap: 20rpx;
}

.team-hint {
  margin: 16rpx 0 8rpx;
  padding: 20rpx 24rpx;
  background: #FFF7ED;
  border: 2rpx solid #FED7AA;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #9A3412;
}

.team-hint.success {
  background: #ECFDF5;
  border-color: #A7F3D0;
  color: #065F46;
}

.step-btn {
  flex: 1;
}

.step-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* Step 2: 队伍卡片 */
.random-group-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.random-group-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.rg-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  background: #FAFAFA;
  border-bottom: 2rpx solid #F3F4F6;
}

.rg-color-bar {
  width: 8rpx;
  height: 48rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.rg-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rg-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.rg-count {
  font-size: 24rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.rg-actions {
  display: flex;
  gap: 20rpx;
}

.rg-action {
  font-size: 24rpx;
  color: #6B7280;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.rg-action.delete {
  color: #EF4444;
  background: #FEE2E2;
}

.rg-body {
  padding: 20rpx 24rpx;
}

.rg-captain-row,
.rg-fixed-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.rg-fixed-row {
  margin-bottom: 0;
}

.rg-label {
  font-size: 26rpx;
  color: #6B7280;
  font-weight: 500;
  flex-shrink: 0;
  width: 100rpx;
}

.rg-captain {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #F59E0B;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.captain-icon {
  font-size: 32rpx;
}

.rg-empty {
  flex: 1;
  font-size: 26rpx;
  color: #D1D5DB;
}

.rg-fixed-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rg-fixed-tag {
  font-size: 24rpx;
  color: #3B82F6;
  background: #DBEAFE;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.add-group-btn-random {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  border: 3rpx dashed #9DB8F5;
  border-radius: 20rpx;
  color: #0052D9;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  background: #ECF2FE;
  transition: all 0.2s ease;
}

.add-group-btn-random:active {
  transform: scale(0.98);
}

/* 选择器按钮 */
.picker-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  border: 2rpx solid #E5E7EB;
  transition: all 0.2s ease;
}

.picker-btn:active {
  border-color: #0052D9;
  background: #ECF2FE;
}

.picker-value {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.picker-placeholder {
  font-size: 28rpx;
  color: #9CA3AF;
}

.required {
  color: #EF4444;
  margin-left: 4rpx;
}

.selected-fixed-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.fixed-chip {
  font-size: 24rpx;
  color: #3B82F6;
  background: #DBEAFE;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* 队员选择弹窗 */
.picker-hint {
  padding: 16rpx 32rpx;
  font-size: 24rpx;
  color: #6B7280;
  background: #F9FAFB;
}

.picker-player-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.picker-player-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: white;
  border-radius: 16rpx;
  border: 3rpx solid #E5E7EB;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.picker-player-item.selected {
  border-color: #10B981;
  background: linear-gradient(135deg, #ECFDF5, #D1FAE5);
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.2);
}

.picker-player-item.selected .pp-name {
  color: #065F46;
  font-weight: 700;
}

.picker-player-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.pp-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pp-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pp-gender-icon {
  width: 32rpx;
  height: 32rpx;
}

.pp-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
}

.pp-disabled-tag {
  font-size: 22rpx;
  color: #9CA3AF;
  background: #F3F4F6;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.pp-check {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pp-circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 3rpx solid #D1D5DB;
}

/* Step 3: 分配结果 */
.shuffle-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx;
  background: #ECF2FE;
  border: 3rpx solid #9DB8F5;
  color: #0052D9;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  transition: all 0.3s ease;
}

.shuffle-btn.shuffling {
  animation: shake 0.5s ease-in-out infinite;
}

@keyframes shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-5deg); }
  75% { transform: rotate(5deg); }
}

.assign-result-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.assign-result-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.ar-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 12rpx;
  background: linear-gradient(135deg, #FAFAFA, #F9FAFB);
  border-bottom: 2rpx solid #F3F4F6;
}

.ar-color-bar {
  width: 8rpx;
  height: 40rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.ar-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.ar-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.ar-stat {
  font-size: 22rpx;
  color: #6B7280;
}

.ar-members {
  padding: 20rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ar-member {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.ar-gender-icon {
  width: 28rpx;
  height: 28rpx;
}

.ar-mname {
  color: #374151;
  font-weight: 500;
}

.ar-mname.captain {
  color: #F59E0B;
  font-weight: 700;
}

.ar-badge {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.ar-badge.captain-badge {
  color: #92400E;
  background: #FEF3C7;
}

.ar-badge.fixed-badge {
  color: #1E40AF;
  background: #DBEAFE;
}

/* Step 4: 点击选择调整（队伍/成员样式对齐 Step3 分配结果） */
.drag-step {
  position: relative;
}

.step-desc-selected {
  display: inline-block;
  color: #0052D9;
  font-weight: 600;
}

.cancel-select-bar {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 20rpx;
  margin: 8rpx 0 20rpx;
  background: linear-gradient(135deg, #ECF2FE, #FFFFFF);
  border: 2rpx solid #BFD3FB;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #0052D9;
  font-weight: 500;
}

.cancel-select-bar:active {
  transform: scale(0.96);
}

/* 与 Step3 .assign-result-list 一致：一行一队，竖向堆叠 */
.drag-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.drag-group {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  transition: all 0.2s ease;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.drag-group:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.drag-group.from-group {
  border-color: #0052D9;
  box-shadow: 0 0 0 2rpx rgba(0, 82, 217, 0.4), 0 4rpx 16rpx rgba(0, 82, 217, 0.2);
}

/* 队伍头部：与 Step3 ar-header 一致（浅灰渐变 + 左侧色条 + 右侧统计） */
.dg-header {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 12rpx;
  background: linear-gradient(135deg, #FAFAFA, #F9FAFB);
  border-bottom: 2rpx solid #F3F4F6;
}

.dg-color-bar {
  width: 8rpx;
  height: 40rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.dg-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.dg-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.dg-count {
  font-size: 22rpx;
  color: #6B7280;
}

.dg-gender-count {
  font-size: 20rpx;
  color: #6B7280;
}

/* 高度随成员数量自适应：去掉固定 min-height/flex，由内容撑开 */
.dg-list {
  padding: 20rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-content: flex-start;
}

/* 成员：与 Step3 ar-member 一致（横向 chip 流式排列） */
.dg-member {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  font-size: 26rpx;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.18s ease;
}

.dg-member:active {
  transform: scale(0.97);
}

.dg-member.selected {
  border-color: #0052D9;
  background: linear-gradient(135deg, #ECF2FE, #E1EBFD);
  box-shadow: 0 4rpx 16rpx rgba(0, 82, 217, 0.25);
  transform: scale(1.02);
}

.dg-member.selected .dg-mname {
  color: #0052D9;
  font-weight: 700;
}

.dg-gender-icon {
  width: 28rpx;
  height: 28rpx;
}

.dg-mname {
  color: #374151;
  font-weight: 500;
}

.dg-mname.orange-name {
  color: #FF6B35;
}

.dg-badge {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.dg-badge.captain-badge {
  color: #92400E;
  background: #FEF3C7;
}

.dg-badge.fixed-badge {
  color: #1E40AF;
  background: #DBEAFE;
}

/* 导入取伙名单按钮 */
.import-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  background: #FFFFFF;
  color: #0052D9;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  border: 2rpx dashed #0052D9;
  transition: all 0.2s ease;
}

.import-btn:active {
  background: #ECF2FE;
  border-style: solid;
}

.import-btn[disabled] {
  opacity: 0.5;
  pointer-events: none;
}

/* 导入预览弹窗 */
.import-modal {
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 90%;
}

.import-modal .modal-header {
  flex-shrink: 0;
}

.import-modal .modal-body {
  flex: 1;
  max-height: none;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  box-sizing: border-box;
}

.import-modal .modal-footer {
  flex-shrink: 0;
}

/* 导入弹窗底部按钮：高度减半 */
.import-modal .modal-footer button {
  padding: 12rpx 40rpx;
  font-size: 28rpx;
  line-height: 1.25;
}

/* 导入弹窗 body 作为 scroll-view 时确保可滚动且高度受约束 */
.import-modal .modal-body {
  display: block;
}

/* 导入队员列表 */
.import-player-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 导入队员项 */
.import-player-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5E7EB;
  position: relative;
  overflow: hidden;
}

.ip-gender {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #DBEAFE;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

.ip-gender:active {
  transform: scale(0.95);
}

.ip-gender-icon {
  width: 32rpx;
  height: 32rpx;
}

.ip-name-input {
  flex: 1;
  height: 64rpx;
  padding: 0 20rpx;
  background: white;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2937;
  box-sizing: border-box;
}

.ip-name-input:focus {
  border-color: #0052D9;
  background: #ECF2FE;
}

.ip-level-input {
  width: 120rpx;
  height: 64rpx;
  padding: 0 12rpx;
  background: white;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2937;
  text-align: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.ip-level-input:focus {
  border-color: #0052D9;
  background: #ECF2FE;
}

.ip-delete {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #FEE2E2;
  flex-shrink: 0;
}
