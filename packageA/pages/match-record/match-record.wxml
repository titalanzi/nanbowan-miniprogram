<view class="container">
  <view class="card header-card">
    <view class="match-name">{{match.name}}</view>
    <view class="match-meta">
      <text>📍 {{match.location || '未知地点'}}</text>
      <text>📅 {{match.date}}</text>
    </view>
  </view>

  <view class="card score-card">
    <view class="score-wrapper">
      <view wx:for="{{groupStats}}" wx:key="groupId" class="team-score">
        <view class="team-label" style="background-color: {{item.color}}">
          {{item.groupName}}
        </view>
        <view class="score-number" bindtap="showTeamStats" data-group-id="{{item.groupId}}">{{item.score}}</view>
        <view class="score-total" bindtap="showTeamStats" data-group-id="{{item.groupId}}">
          <text class="total-label">助攻: {{item.assist}}</text>
          <text class="total-label">D盘: {{item.dDisc}}</text>
          <text class="total-label">烂盘: {{item.turnover}}</text>
        </view>
      </view>
    </view>
    <view class="view-members-btn" bindtap="showGroupMembers">
      👥 查看分组成员
    </view>
  </view>

  <view wx:if="{{canEdit}}" class="card">
    <view class="section-title">选择队伍</view>
    <view class="group-selector">
      <view wx:for="{{match.groups}}" wx:key="id" 
        class="group-option {{selectedGroupIndex === index ? 'selected' : ''}}"
        style="background-color: {{selectedGroupIndex === index ? item.color : '#F3F4F6'}}"
        bindtap="selectGroup" data-index="{{index}}">
        <text style="color: {{selectedGroupIndex === index ? 'white' : '#374151'}}">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{canEdit && selectedGroupIndex !== null}}" class="card">
    <view class="section-title">选择球员</view>
    <view class="member-selector">
      <view wx:for="{{currentGroup.members}}" wx:key="id" 
        class="member-option {{selectedMemberIndex === index ? 'selected' : ''}}"
        bindtap="selectMember" data-index="{{index}}">
        <text class="member-name">{{item.name}}</text>
      </view>
    </view>

    <view wx:if="{{selectedMemberIndex !== null}}">
      <view class="section-title">选择统计</view>
      <view class="stat-selector">
        <view wx:for="{{match.statTypes}}" wx:key="id" 
          class="stat-option"
          style="background-color: {{item.color}}"
          bindtap="addRecord" data-stat="{{item}}">
          +1 {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!canEdit}}" class="card">
    <view class="no-permission-tip">
      <text class="tip-icon">🔒</text>
      <text class="tip-text">只有比赛创建者可编辑记录</text>
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <view class="section-title">比赛记录</view>
      <text wx:if="{{canEdit}}" class="clear-btn" bindtap="showUndoConfirm">撤销上一条</text>
    </view>
    <scroll-view wx:if="{{match.records.length > 0}}" class="records-scroll" scroll-y>
      <view wx:for="{{match.records}}" wx:key="id" wx:for-item="record" class="record-item">
        <view class="record-time">{{record.time}}</view>
        <view class="record-content">
          <view class="record-group" style="color: {{record.groupColor}}">{{record.groupName}}</view>
          <text>{{record.memberName}}</text>
          <view class="record-stat" style="background-color: {{record.statColor}}">{{record.statName}}</view>
        </view>
        <view wx:if="{{canEdit}}" class="record-delete" bindtap="deleteRecord" data-recordid="{{record.id}}">×</view>
      </view>
    </scroll-view>
    <view wx:else class="empty-tip">
      暂无记录
    </view>
  </view>

  <view wx:if="{{canEdit}}" class="footer-wrapper">
    <button class="btn-secondary edit-groups-btn" bindtap="editGroups">编辑分组</button>
    <button class="btn-secondary finish-btn" bindtap="showFinishConfirm">结束比赛</button>
  </view>
</view>

<!-- 队伍队员数据弹窗 -->
<view wx:if="{{showTeamStatsModal}}" class="modal-overlay" bindtap="hideTeamStatsModal">
  <view class="team-stats-modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="modal-title-text">📊 {{currentTeamName}} - 队员数据</view>
      <view class="modal-close" bindtap="hideTeamStatsModal">✕</view>
    </view>
    <scroll-view class="team-stats-scroll" scroll-y>
      <view wx:for="{{currentTeamMembers}}" wx:key="id" class="team-stats-item">
        <view class="team-stats-info">
          <text class="team-stats-name">{{item.name}}</text>
          <view class="team-stats-details">
            <text class="team-stat-tag score">得分: {{item.score}}</text>
            <text class="team-stat-tag assist">助攻: {{item.assist}}</text>
            <text class="team-stat-tag d-disc">D盘: {{item.dDisc}}</text>
            <text class="team-stat-tag turnover">烂盘: {{item.turnover}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!currentTeamMembers || currentTeamMembers.length === 0}}" class="empty-members">
        暂无队员数据
      </view>
    </scroll-view>
  </view>
</view>

<!-- 分组成员弹窗 -->
<van-popup show="{{showGroupMembersModal}}" position="center" round custom-style="width: 94%; max-height: 92vh;" bind:close="hideGroupMembers">
  <view class="members-modal-wrapper">
    <!-- 标题栏 -->
    <view class="modal-header-bar">
      <view class="header-left">
        <van-icon name="friends-o" size="20px" color="#fff" />
        <text class="header-title">分组成员</text>
      </view>
      <view class="header-right" bindtap="hideGroupMembers" hover-class="btn-hover">
        <van-icon name="cross" size="22px" color="#FF6B35" />
      </view>
    </view>
    
    <!-- 比赛信息 -->
    <view class="match-info-card">
      <view class="match-title">{{match.name}}</view>
      <view class="match-meta-row">
        <van-icon name="location-o" size="14px" color="#6B7280" />
        <text class="meta-text">{{match.location || '未知地点'}}</text>
        <van-icon name="calendar-o" size="14px" color="#6B7280" custom-style="margin-left: 24rpx;" />
        <text class="meta-text">{{match.date}}</text>
      </view>
    </view>
    
    <!-- 分组列表 -->
    <scroll-view class="groups-scroll-area" scroll-y>
      <view wx:for="{{match.groups}}" wx:key="id" class="group-card">
        <!-- 分组头部 -->
        <view class="group-header-bar" style="background-color: {{item.color}}">
          <view class="group-left">
            <van-icon name="user-o" size="18px" color="#fff" />
            <text class="group-name-text">{{item.name}}</text>
          </view>
          <view class="group-right">
            <view class="gender-stats">
              <image class="stats-gender-icon" src="/images/男.png" mode="aspectFit"></image>
              <text class="stats-count">{{item.maleCount}}</text>
              <text class="stats-divider">/</text>
              <image class="stats-gender-icon" src="/images/女.png" mode="aspectFit"></image>
              <text class="stats-count">{{item.femaleCount}}</text>
            </view>
          </view>
        </view>
        
        <!-- 成员列表 -->
        <view class="members-grid">
          <view wx:for="{{item.members}}" wx:key="id" wx:for-item="member" class="member-tag-item" hover-class="member-hover">
            <view class="member-badge" style="background-color: {{item.color}}">
              {{index + 1}}
            </view>
            <text class="member-name-text">{{member.name}}</text>
            <image class="member-gender-img" src="{{member.gender === 'female' ? '/images/女.png' : '/images/男.png'}}" mode="aspectFit"></image>
          </view>
          <view wx:if="{{!item.members || item.members.length === 0}}" class="empty-placeholder">
            <van-icon name="info-o" size="16px" color="#9CA3AF" />
            <text class="empty-text">暂无成员</text>
          </view>
        </view>
      </view>
    </scroll-view>
    
    <!-- 底部提示 -->
    <view class="footer-tip-bar">
      <view class="footer-left">
        <van-icon name="photo-o" size="14px" color="#9CA3AF" />
        <text class="footer-tip-text">截图此页面分享到群里</text>
      </view>
      <view class="download-image-btn" bindtap="downloadGroupImage">
        <van-icon name="down" size="14px" color="#fff" />
        <text class="download-image-text">保存图片</text>
      </view>
    </view>
  </view>
</van-popup>

<!-- 隐藏 canvas 用于绘制分组图片 -->
<canvas type="2d" id="groupShareCanvas" class="share-canvas"></canvas>