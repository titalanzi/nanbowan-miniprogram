.header-card {
  text-align: center;
}

.match-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 16rpx;
}

.match-meta {
  display: flex;
  justify-content: center;
  gap: 36rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.score-card {
  padding: 36rpx 24rpx;
  background: linear-gradient(135deg, #FFF7ED, #FFFFFF);
}

.score-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.team-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.team-label {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.15);
  white-space: nowrap;
}

.score-number {
  font-size: 80rpx;
  font-weight: 800;
  color: #111827;
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.score-total {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.total-label {
  font-size: 24rpx;
  color: #6B7280;
  text-align: center;
  font-weight: 500;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.clear-btn {
  font-size: 26rpx;
  color: #EF4444;
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: #FEF2F2;
  border-radius: 16rpx;
}

.group-selector {
  display: flex;
  gap: 20rpx;
}

.group-option {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.member-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.member-option {
  background: #F3F4F6;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  transition: all 0.3s ease;
}

.member-option.selected {
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.3);
}

.member-option.selected .member-number,
.member-option.selected .member-name {
  color: white;
}

.member-number {
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 600;
}

.member-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.stat-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-option {
  padding: 20rpx 36rpx;
  border-radius: 48rpx;
  color: white;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.records-scroll {
  max-height: 480rpx;
}

.record-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
  align-items: center;
  transition: all 0.3s ease;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:hover {
  background: #F9FAFB;
}

.record-time {
  font-size: 26rpx;
  color: #9CA3AF;
  min-width: 96rpx;
  font-weight: 500;
}

.record-content {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
}

.record-group {
  font-weight: 700;
}

.record-stat {
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  color: white;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.record-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #EF4444;
  flex-shrink: 0;
  background: #FEF2F2;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.record-delete:active {
  background: #FECACA;
  transform: scale(0.95);
}

.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #9CA3AF;
  font-size: 30rpx;
  font-weight: 500;
}

.no-permission-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 24rpx;
  text-align: center;
}

.tip-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.tip-text {
  font-size: 30rpx;
  color: #6B7280;
  font-weight: 500;
}

.footer-wrapper {
  padding: 28rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.edit-groups-btn {
  background: linear-gradient(135deg, #3B82F6, #1D4ED8);
  color: white;
}

.finish-btn {
  background: linear-gradient(135deg, #EF4444, #DC2626);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.35);
}

.view-members-btn {
  margin-top: 24rpx;
  text-align: center;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #10B981, #059669);
  color: white;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.25);
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

/* Vant 弹窗样式重构 */
.members-modal-wrapper {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 92vh;
  background: #FAFAFA;
}

.modal-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #FF6B35, #F59E0B);
  flex-shrink: 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: white;
  letter-spacing: 1rpx;
}

.header-right {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.95);
}

.match-info-card {
  padding: 20rpx 24rpx;
  background: white;
  text-align: center;
  border-bottom: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.match-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}

.match-meta-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #6B7280;
}

.groups-scroll-area {
  flex: 1;
  padding: 16rpx 20rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.group-card {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.group-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
}

.group-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-name-text {
  font-size: 26rpx;
  font-weight: 700;
  color: white;
  letter-spacing: 0.5rpx;
}

.gender-stats {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
}

.stats-gender-icon {
  width: 28rpx;
  height: 28rpx;
}

.stats-count {
  font-size: 22rpx;
  font-weight: 600;
  color: white;
}

.stats-divider {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  margin: 0 2rpx;
}

.members-grid {
  padding: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-tag-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #F9FAFB;
  padding: 12rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #E5E7EB;
}

.member-hover {
  background: #F3F4F6;
  transform: scale(0.98);
}

.member-badge {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 50%;
  flex-shrink: 0;
}

.member-name-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
}

.member-gender-img {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.empty-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  padding: 24rpx;
}

.empty-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.footer-tip-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: white;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.footer-tip-text {
  font-size: 20rpx;
  color: #9CA3AF;
  font-weight: 500;
}

/* 队伍队员数据弹窗 */
.team-stats-modal-content {
  width: 92%;
  max-height: 85vh;
  background: #FAFAFA;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.18);
}

.team-stats-scroll {
  flex: 1;
  padding: 24rpx;
  max-height: 70vh;
}

.team-stats-item {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.team-stats-item:last-child {
  margin-bottom: 0;
}

.team-stats-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.team-stats-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 1rpx;
}

.team-stats-details {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.team-stat-tag {
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.team-stat-tag.score {
  background: linear-gradient(135deg, #D1FAE5, #A7F3D0);
  color: #065F46;
}

.team-stat-tag.assist {
  background: linear-gradient(135deg, #DBEAFE, #BFDBFE);
  color: #1E40AF;
}

.team-stat-tag.d-disc {
  background: linear-gradient(135deg, #FEF3C7, #FDE68A);
  color: #92400E;
}

.team-stat-tag.turnover {
  background: linear-gradient(135deg, #FEE2E2, #FECACA);
  color: #B91C1C;
}

.empty-members {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 分组成员弹窗样式优化 */
.members-modal-content {
  width: 92%;
  max-height: 90vh;
  background: #FAFAFA;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.18);
}