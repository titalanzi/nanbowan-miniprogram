.container {
  padding: 12rpx;
  min-height: 100vh;
  background: #F8F9FB;
}

.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 12rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
}

.add-group-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  background: #FF6B35;
  border-radius: 12rpx;
  color: white;
  font-size: 24rpx;
  font-weight: 500;
  border: none;
  line-height: 1.2;
  margin: 0;
}

.add-icon {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.no-permission-card {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.no-permission-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #667085;
  font-weight: 500;
}

.groups-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.group-card {
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
  border: 4rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.group-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.group-card.from-group {
  border-color: #FCD34D;
  box-shadow: 0 0 0 2rpx rgba(252, 211, 77, 0.4), 0 4rpx 16rpx rgba(252, 211, 77, 0.2);
}

.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 14rpx;
  border-left: 5rpx solid;
  background: #F9FAFB;
  transition: all 0.18s ease;
}

.group-header:active {
  background: #F3F4F6;
  transform: scale(0.99);
}

.group-name {
  font-size: 26rpx;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-actions {
  display: flex;
  gap: 5rpx;
}

.action-btn {
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.action-btn.edit {
  background: #EFF6FF;
  color: #3B82F6;
}

.action-btn.delete {
  background: #FEF2F2;
  color: #EF4444;
}

.members-section {
  padding: 12rpx 14rpx;
}

.members-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #667085;
  margin-bottom: 12rpx;
  display: block;
}

.members-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.member-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: #F9FAFB;
  border-radius: 32rpx;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.18s ease;
  cursor: pointer;
}

.member-item:active {
  transform: scale(0.95);
}

.member-item.selected {
  border-color: #FF6B35;
  background: linear-gradient(135deg, #FFF7ED, #FFEDD5);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.25);
}

.member-item.selected .member-name {
  color: #FF6B35;
  font-weight: 700;
}

.member-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.member-number {
  font-size: 18rpx;
  color: #98A2B3;
  font-weight: 500;
}

.member-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #344054;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-name.orange-name {
  color: #FF6B35;
}

.member-gender-icon {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.9;
}

.member-delete {
  font-size: 20rpx;
  color: #EF4444;
  font-weight: 500;
  padding: 4rpx 10rpx;
  background: #FEF2F2;
  border-radius: 8rpx;
  margin-left: 6rpx;
}

.empty-members-tip {
  text-align: center;
  padding: 20rpx;
  color: #98A2B3;
  font-size: 22rpx;
}

.add-member-btn {
  text-align: center;
  padding: 8rpx;
  color: #FF6B35;
  font-size: 22rpx;
  font-weight: 500;
  background: #FFF6ED;
  border-radius: 10rpx;
  border: 1rpx dashed #FFCD99;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 28rpx;
  color: #101828;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #475467;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid #E4E7EC;
}

.form-input:focus {
  border-color: #FF6B35;
  background: white;
}

.color-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.color-option {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}

.color-option.selected {
  border-color: #101828;
  transform: scale(1.1);
}

.gender-options {
  display: flex;
  gap: 16rpx;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  border: 2rpx solid #E4E7EC;
  transition: all 0.2s ease;
}

.gender-option.selected {
  border-color: #FF6B35;
  background: #FFF6ED;
}

.gender-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.gender-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #475467;
}

.gender-option.selected .gender-text {
  color: #FF6B35;
  font-weight: 600;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #F2F4F7;
  color: #475467;
}

.modal-btn.confirm {
  background: #FF6B35;
  color: white;
}

/* ========== 成员移动提示栏 ========== */
.edit-tip-bar {
  background: white;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border-left: 6rpx solid #FF6B35;
}

.tip-default {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  color: #475467;
  font-weight: 500;
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF6B35;
  box-shadow: 0 0 0 4rpx rgba(255, 107, 53, 0.2);
  flex-shrink: 0;
}

.tip-selected {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tip-selected-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
}

.tip-selected-label {
  color: #475467;
  font-weight: 500;
}

.tip-selected-name {
  color: #FF6B35;
  font-weight: 700;
  font-size: 28rpx;
}

.tip-cancel-btn {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 500;
  padding: 8rpx 18rpx;
  background: linear-gradient(135deg, #FFF7ED, #FFFFFF);
  border: 2rpx solid #FFD4B8;
  border-radius: 20rpx;
}

.tip-cancel-btn:active {
  transform: scale(0.96);
}