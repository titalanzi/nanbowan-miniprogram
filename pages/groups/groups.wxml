<view class="container">
  <view class="page-header">
    <text class="page-title">分组管理</text>
    <button class="add-btn" bindtap="showAddGroupModal">+ 新建分组</button>
  </view>

  <view wx:if="{{groups.length === 0}}" class="empty-state">
    <text class="empty-icon">👥</text>
    <text class="empty-text">暂无分组</text>
    <text class="empty-hint">点击右上角按钮创建分组</text>
  </view>

  <view wx:else class="group-list">
    <view 
      wx:for="{{groups}}" 
      wx:key="id" 
      class="group-card"
    >
      <view class="group-header" bindtap="viewGroupMembers" data-group="{{item}}">
        <view class="group-color" style="background-color: {{item.color}}"></view>
        <view class="group-info">
          <text class="group-name">{{item.name}}</text>
          <text class="group-members">{{getMemberCount(item.id)}} 名成员</text>
        </view>
        <text class="group-arrow">›</text>
      </view>
      <view class="group-actions">
        <text class="action-btn edit" bindtap="editGroup" data-group="{{item}}">编辑</text>
        <text class="action-btn delete" bindtap="deleteGroup" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showAddModal}}" class="modal-overlay" bindtap="closeAddModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{editingGroupId ? '编辑分组' : '新建分组'}}</text>
        <text class="modal-close" bindtap="closeAddModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">分组名称</text>
          <input class="form-input" placeholder="请输入分组名称" value="{{newGroupName}}" bindinput="onGroupNameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">分组颜色</text>
          <view class="color-options">
            <view 
              wx:for="{{colorOptions}}" 
              wx:key="*this" 
              class="color-option {{newGroupColor === item ? 'selected' : ''}}"
              style="background-color: {{item}}"
              bindtap="selectColor"
              data-color="{{item}}"
            ></view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeAddModal">取消</button>
        <button class="btn-primary" bindtap="saveGroup">保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showMemberModal}}" class="modal-overlay" bindtap="closeMemberModal">
    <view class="modal-content member-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <view class="group-title-row">
          <view class="group-color small" style="background-color: {{selectedGroup.color}}"></view>
          <text class="modal-title">{{selectedGroup.name}}</text>
        </view>
        <text class="modal-close" bindtap="closeMemberModal">×</text>
      </view>
      <view class="modal-body">
        <view class="member-list-header">
          <text class="member-count">成员列表 ({{groupMembers.length}})</text>
          <text class="add-member-btn" bindtap="showAddMemberModal">+ 添加成员</text>
        </view>
        
        <view wx:if="{{groupMembers.length === 0}}" class="empty-state small">
          <text class="empty-icon">👤</text>
          <text class="empty-text">暂无成员</text>
          <text class="empty-hint">点击上方按钮添加成员</text>
        </view>

        <scroll-view wx:else class="member-list" scroll-y>
          <view 
            wx:for="{{groupMembers}}" 
            wx:key="id" 
            class="member-item"
          >
            <view class="member-info">
              <text class="member-name">{{item.name}}</text>
            </view>
            <view class="member-actions">
              <text class="action-btn edit" bindtap="editMember" data-member="{{item}}">编辑</text>
              <text class="action-btn delete" bindtap="deleteMember" data-id="{{item.id}}">删除</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <view wx:if="{{showMemberDetail}}" class="modal-overlay" bindtap="closeMemberDetail">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">{{editingMemberId ? '编辑成员' : '添加成员'}}</text>
        <text class="modal-close" bindtap="closeMemberDetail">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">成员姓名</text>
          <input class="form-input" placeholder="请输入姓名" value="{{newMemberName}}" bindinput="onMemberNameInput" />
        </view>
        <view class="form-item">
          <text class="form-label">球衣号码</text>
          <input class="form-input" placeholder="请输入号码" type="number" value="{{newMemberNumber}}" bindinput="onMemberNumberInput" />
        </view>
        <view class="form-item">
          <text class="form-label">位置</text>
          <view class="position-options">
            <view 
              wx:for="{{positionOptions}}" 
              wx:key="value" 
              class="position-option {{newMemberPosition === item.value ? 'selected' : ''}}"
              bindtap="selectPosition"
              data-position="{{item.value}}"
            >
              {{item.label}}
            </view>
          </view>
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeMemberDetail">取消</button>
        <button class="btn-primary" bindtap="saveMember">保存</button>
      </view>
    </view>
  </view>
</view>