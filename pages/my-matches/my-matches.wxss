.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.create-btn {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 500;
}

.match-card {
  margin-bottom: 20rpx;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.match-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.match-status {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.match-status.active {
  background: #D1FAE5;
  color: #065F46;
}

.match-status.finished {
  background: #F3F4F6;
  color: #6B7280;
}

.match-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.info-item {
  font-size: 26rpx;
  color: #6B7280;
}

.match-stats {
  display: flex;
  gap: 24rpx;
}

.stat-text {
  font-size: 26rpx;
  color: #9CA3AF;
}
