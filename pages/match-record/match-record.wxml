<view class="container">
  <view class="card header-card">
    <view class="match-name">{{match.name}}</view>
    <view class="match-meta">
      <text>📍 {{match.location || '未知地点'}}</text>
      <text>📅 {{match.date}}</text>
    </view>
  </view>

  <view class="card score-card">
    <view class="score-wrapper">
      <view wx:for="{{match.groups}}" wx:key="id" class="team-score">
        <view class="team-label" style="background-color: {{item.color}}">
          {{item.name}}
        </view>
        <view class="score-number">{{getGroupScore(item.id)}}</view>
      </view>
    </view>
    <view class="view-members-btn" bindtap="showGroupMembers">
      👥 查看分组成员
    </view>
  </view>

  <view wx:if="{{canEdit}}" class="card">
    <view class="section-title">选择队伍</view>
    <view class="group-selector">
      <view wx:for="{{match.groups}}" wx:key="id" 
        class="group-option {{selectedGroupIndex === index ? 'selected' : ''}}"
        style="background-color: {{selectedGroupIndex === index ? item.color : '#F3F4F6'}}"
        bindtap="selectGroup" data-index="{{index}}">
        <text style="color: {{selectedGroupIndex === index ? 'white' : '#374151'}}">{{item.name}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{canEdit && selectedGroupIndex !== null}}" class="card">
    <view class="section-title">选择球员</view>
    <view class="member-selector">
      <view wx:for="{{currentGroup.members}}" wx:key="id" 
        class="member-option {{selectedMemberIndex === index ? 'selected' : ''}}"
        bindtap="selectMember" data-index="{{index}}">
        <text class="member-name">{{item.name}}</text>
      </view>
    </view>

    <view wx:if="{{selectedMemberIndex !== null}}">
      <view class="section-title">选择统计</view>
      <view class="stat-selector">
        <view wx:for="{{match.statTypes}}" wx:key="id" 
          class="stat-option"
          style="background-color: {{item.color}}"
          bindtap="addRecord" data-stat="{{item}}">
          +1 {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!canEdit}}" class="card">
    <view class="no-permission-tip">
      <text class="tip-icon">🔒</text>
      <text class="tip-text">只有比赛创建者可编辑记录</text>
    </view>
  </view>

  <view class="card">
    <view class="section-header">
      <view class="section-title">比赛记录</view>
      <text wx:if="{{canEdit}}" class="clear-btn" bindtap="showUndoConfirm">撤销上一条</text>
    </view>
    <scroll-view wx:if="{{match.records.length > 0}}" class="records-scroll" scroll-y>
      <view wx:for="{{match.records}}" wx:key="id" wx:for-item="record" class="record-item">
        <view class="record-time">{{record.time}}</view>
        <view class="record-content">
          <view class="record-group" style="color: {{record.groupColor}}">{{record.groupName}}</view>
          <text>{{record.memberName}}</text>
          <view class="record-stat" style="background-color: {{record.statColor}}">{{record.statName}}</view>
        </view>
        <view wx:if="{{canEdit}}" class="record-delete" bindtap="deleteRecord" data-recordid="{{record.id}}">×</view>
      </view>
    </scroll-view>
    <view wx:else class="empty-tip">
      暂无记录
    </view>
  </view>

  <view wx:if="{{canEdit}}" class="footer-wrapper">
    <button class="btn-secondary edit-groups-btn" bindtap="editGroups">编辑分组</button>
    <button class="btn-secondary finish-btn" bindtap="showFinishConfirm">结束比赛</button>
  </view>
</view>

<!-- 分组成员弹窗 -->
<view wx:if="{{showGroupMembersModal}}" class="modal-overlay" bindtap="hideGroupMembers">
  <view class="members-modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="modal-title-text">📋 分组成员</view>
      <view class="modal-close" bindtap="hideGroupMembers">✕</view>
    </view>
    
    <view class="match-info-display">
      <view class="match-name-display">{{match.name}}</view>
      <view class="match-meta-display">
        <text>📍 {{match.location || '未知地点'}}</text>
        <text>📅 {{match.date}}</text>
      </view>
    </view>
    
    <scroll-view class="members-modal-scroll" scroll-y>
      <view wx:for="{{match.groups}}" wx:key="id" class="group-display-card">
        <view class="group-display-header" style="background-color: {{item.color}}">
          <view class="group-display-name">{{item.name}}</view>
          <view class="group-stats">
            <text class="stat-item">
              <text class="stat-text">男</text>
              <text class="stat-value">{{item.maleCount}}</text>
            </text>
            <text class="stat-divider">/</text>
            <text class="stat-item">
              <text class="stat-text">女</text>
              <text class="stat-value">{{item.femaleCount}}</text>
            </text>
          </view>
        </view>
        <view class="group-members-display">
          <view wx:for="{{item.members}}" wx:key="id" wx:for-item="member" class="member-display-item">
            <text class="member-number-display" style="background-color: {{item.color}}">{{index + 1}}</text>
            <text class="member-name-display">{{member.name}}</text>
            <image class="member-gender-icon" src="{{member.gender === 'female' ? '/images/女.png' : '/images/男.png'}}" mode="aspectFit"></image>
          </view>
          <view wx:if="{{!item.members || item.members.length === 0}}" class="empty-members-display">
            暂无成员
          </view>
        </view>
      </view>
    </scroll-view>
    
    <view class="modal-footer">
      <view class="screenshot-tip">💡 截图此页面发到群里</view>
    </view>
  </view>
</view>