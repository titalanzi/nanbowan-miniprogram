<view class="container">
  <view class="header-section">
    <text class="page-title">编辑分组</text>
    <button wx:if="{{canEdit}}" class="add-group-btn" bindtap="showAddGroupModal">
      <text class="add-icon">+</text>
      <text>添加队伍</text>
    </button>
  </view>

  <view wx:if="{{!canEdit}}" class="no-permission-card">
    <view class="no-permission-tip">
      <text class="tip-icon">🔒</text>
      <text class="tip-text">只有比赛创建者可编辑分组</text>
    </view>
  </view>

  <view wx:if="{{canEdit}}" class="groups-list">
    <view wx:for="{{match.groups}}" wx:key="id" class="group-card">
      <view class="group-header" style="border-left-color: {{item.color}}">
        <view class="group-name" style="color: {{item.color}}">{{item.name}}</view>
        <view class="group-actions">
          <text class="action-btn edit" bindtap="editGroup" data-index="{{index}}">编辑</text>
          <text class="action-btn delete" bindtap="deleteGroup" data-index="{{index}}">删除</text>
        </view>
      </view>

      <view class="members-section">
        <view class="members-list">
          <view wx:for="{{item.members}}" wx:key="id" wx:for-item="member" wx:for-index="memberIdx" class="member-item">
            <view class="member-info">
              <text class="member-name">{{member.name}}</text>
              <image class="member-gender-icon" src="{{member.gender === 'female' ? '/images/女.png' : '/images/男.png'}}" mode="aspectFit"></image>
            </view>
            <text class="member-delete" bindtap="deleteMember" 
              data-groupindex="{{index}}" data-memberindex="{{memberIdx}}">×</text>
          </view>
          <view wx:if="{{item.members.length === 0}}" class="empty-members-tip">暂无成员</view>
        </view>
        <view class="add-member-btn" bindtap="showAddMemberModal" data-groupindex="{{index}}">
          + 添加成员
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showAddGroupModal}}" class="modal-overlay" bindtap="closeAddGroupModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">添加队伍</view>
      <view class="form-item">
        <text class="form-label">队伍名称</text>
        <input class="form-input" placeholder="请输入队伍名称" 
          value="{{newGroupName}}" bindinput="onNewGroupNameInput" />
      </view>
      <view class="form-item">
        <text class="form-label">队伍颜色</text>
        <view class="color-options">
          <view wx:for="{{colorOptions}}" wx:key="*this" 
            class="color-option {{newGroupColor === item ? 'selected' : ''}}"
            style="background-color: {{item}}" bindtap="selectNewGroupColor" 
            data-color="{{item}}"></view>
        </view>
      </view>
      <view class="modal-actions">
        <text class="modal-btn cancel" bindtap="closeAddGroupModal">取消</text>
        <text class="modal-btn confirm" bindtap="addGroup">确定</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showEditGroupModal}}" class="modal-overlay" bindtap="closeEditGroupModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">编辑队伍</view>
      <view class="form-item">
        <text class="form-label">队伍名称</text>
        <input class="form-input" placeholder="请输入队伍名称" 
          value="{{editingGroupName}}" bindinput="onEditingGroupNameInput" />
      </view>
      <view class="form-item">
        <text class="form-label">队伍颜色</text>
        <view class="color-options">
          <view wx:for="{{colorOptions}}" wx:key="*this" 
            class="color-option {{editingGroupColor === item ? 'selected' : ''}}"
            style="background-color: {{item}}" bindtap="selectEditingGroupColor" 
            data-color="{{item}}"></view>
        </view>
      </view>
      <view class="modal-actions">
        <text class="modal-btn cancel" bindtap="closeEditGroupModal">取消</text>
        <text class="modal-btn confirm" bindtap="saveGroupEdit">确定</text>
      </view>
    </view>
  </view>

  <view wx:if="{{showAddMemberModal}}" class="modal-overlay" bindtap="closeAddMemberModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-title">添加成员</view>
      <view class="form-item">
        <text class="form-label">成员名称</text>
        <input class="form-input" placeholder="请输入成员名称" 
          value="{{newMemberName}}" bindinput="onNewMemberNameInput" />
      </view>
      <view class="form-item">
          <text class="form-label">性别</text>
          <view class="gender-options">
            <view class="gender-option {{newMemberGender === 'male' ? 'selected' : ''}}" 
              bindtap="selectNewMemberGender" data-gender="male">
              <image class="gender-icon" src="/images/男.png" mode="aspectFit"></image>
              <text class="gender-text">男</text>
            </view>
            <view class="gender-option {{newMemberGender === 'female' ? 'selected' : ''}}" 
              bindtap="selectNewMemberGender" data-gender="female">
              <image class="gender-icon" src="/images/女.png" mode="aspectFit"></image>
              <text class="gender-text">女</text>
            </view>
          </view>
        </view>
      <view class="modal-actions">
        <text class="modal-btn cancel" bindtap="closeAddMemberModal">取消</text>
        <text class="modal-btn confirm" bindtap="addMember">确定</text>
      </view>
    </view>
  </view>
</view>