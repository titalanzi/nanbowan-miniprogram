<view class="container">
  <view class="header">
    <view class="header-content">
      <text class="app-name">南波万飞盘</text>
      <text class="app-subtitle">飞盘比赛计分系统</text>
    </view>
    <view class="header-icon">🥏</view>
  </view>

  <view class="stats-grid">
    <view class="stat-item" bindtap="goToPage" data-page="matches">
      <view class="stat-value">{{stats.totalMatches}}</view>
      <view class="stat-label">比赛场次</view>
    </view>
    <view class="stat-item" bindtap="goToPage" data-page="groups">
      <view class="stat-value">{{stats.totalGroups}}</view>
      <view class="stat-label">分组数量</view>
    </view>
    <view class="stat-item" bindtap="goToPage" data-page="groups">
      <view class="stat-value">{{stats.totalMembers}}</view>
      <view class="stat-label">成员总数</view>
    </view>
    <view class="stat-item" bindtap="goToPage" data-page="rankings">
      <view class="stat-value">{{stats.totalScores}}</view>
      <view class="stat-label">总得分</view>
    </view>
  </view>

  <view class="card">
    <view class="card-header">
      <text class="card-title">最近比赛</text>
      <text class="card-more" bindtap="goToPage" data-page="matches">查看全部</text>
    </view>
    
    <view wx:if="{{recentMatches.length === 0}}" class="empty-state">
      <text class="empty-icon">🏆</text>
      <text class="empty-text">暂无比赛记录</text>
      <text class="empty-hint">点击下方按钮创建新比赛</text>
    </view>

    <view wx:else class="match-list">
      <view 
        wx:for="{{recentMatches}}" 
        wx:key="id" 
        class="match-card"
        bindtap="viewMatchDetail"
        data-id="{{item.id}}"
      >
        <view class="match-teams">
          <view class="team-item">
            <view class="team-color" style="background-color: {{item.groupAColor}}"></view>
            <text class="team-name">{{item.groupAName}}</text>
          </view>
          <view class="vs">VS</view>
          <view class="team-item">
            <view class="team-color" style="background-color: {{item.groupBColor}}"></view>
            <text class="team-name">{{item.groupBName}}</text>
          </view>
        </view>
        <view class="match-score">
          <text class="score-a">{{item.groupAScore}}</text>
          <text class="score-divider">:</text>
          <text class="score-b">{{item.groupBScore}}</text>
        </view>
        <view class="match-info">
          <text class="match-date">{{item.date}}</text>
          <text class="match-location">{{item.location}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-btn primary" bindtap="goToCreateMatch">
      <text class="action-icon">➕</text>
      <text class="action-text">创建比赛</text>
    </view>
    <view class="action-btn" bindtap="goToPage" data-page="rankings">
      <text class="action-icon">🏆</text>
      <text class="action-text">查看榜单</text>
    </view>
    <view class="action-btn" bindtap="goToPage" data-page="groups">
      <text class="action-icon">👥</text>
      <text class="action-text">分组管理</text>
    </view>
  </view>
</view>