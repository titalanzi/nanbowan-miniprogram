.header {
  padding: 16rpx 0 24rpx;
}

.header-content {
  flex: 1;
}

.app-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
  display: block;
}

.app-subtitle {
  font-size: 26rpx;
  color: #667085;
  margin-top: 8rpx;
  display: block;
}

.header-icon {
  font-size: 56rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 12rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.stat-item:active {
  transform: scale(0.96);
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #101828;
}

.stat-label {
  font-size: 22rpx;
  color: #98A2B3;
  margin-top: 6rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #101828;
}

.card-more {
  font-size: 26rpx;
  color: #667085;
}

.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #667085;
  display: block;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #98A2B3;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.match-card {
  background: #F9FAFB;
  border-radius: 16rpx;
  padding: 20rpx;
  transition: all 0.2s ease;
}

.match-card:active {
  background: #F2F4F7;
}

.match-teams {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.team-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.team-color {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.team-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #344054;
}

.vs {
  font-size: 22rpx;
  color: #98A2B3;
  font-weight: 500;
}

.match-score {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.score-a, .score-b {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B35;
}

.score-divider {
  font-size: 28rpx;
  color: #98A2B3;
}

.match-info {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  font-size: 22rpx;
  color: #98A2B3;
}

.quick-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-bottom: 120rpx;
}

.action-btn {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.96);
  background: #F9FAFB;
}

.action-btn.primary {
  background: #FF6B35;
}

.action-btn.primary .action-text {
  color: white;
}

.action-btn.primary .action-icon {
  color: white;
}

.action-icon {
  font-size: 36rpx;
  display: block;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #344054;
  font-weight: 500;
}