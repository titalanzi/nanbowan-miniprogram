.container {
  padding: 0 0 40rpx;
  background: #F7F8FA;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 顶部固定栏 */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  box-shadow: 0 1rpx 0 rgba(0, 0, 0, 0.04);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 38rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #98A2B3;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
  height: 100%;
}

.clear-icon {
  font-size: 24rpx;
  color: #98A2B3;
  padding: 12rpx;
}

.toc-btn {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 38rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.toc-btn:active {
  background: #ECF2FE;
}

.toc-icon {
  font-size: 36rpx;
}

/* 规则主体 */
.rules-list {
  padding-top: 116rpx;
  padding: 116rpx 24rpx 40rpx;
}

.chapter-section {
  margin-bottom: 32rpx;
}

.chapter-header {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 24rpx 0 12rpx;
}

.chapter-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #0052D9;
}

.chapter-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
}

/* 关键词标签 */
.keyword-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 4rpx 0 16rpx;
}

.keyword-tag {
  font-size: 22rpx;
  color: #0052D9;
  background: #ECF2FE;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 子章节 */
.sub-chapter {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.sub-chapter-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
  margin-bottom: 12rpx;
}

.sub-chapter-num {
  font-size: 30rpx;
  font-weight: 700;
  color: #0052D9;
}

.sub-chapter-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
}

/* 条文列表 */
.section-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.section-item:last-child {
  border-bottom: none;
}

.section-line {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.section-num {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #0052D9;
  min-width: 60rpx;
}

.section-text {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

/* 子条文 */
.sub-section-list {
  margin-left: 72rpx;
  margin-top: 12rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid #ECF2FE;
}

.sub-section-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 8rpx 0;
}

.sub-section-num {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #F59E0B;
  min-width: 70rpx;
}

.sub-section-text {
  flex: 1;
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
}

/* 子子条文 */
.sub-sub-section-list {
  margin-left: 78rpx;
  margin-top: 4rpx;
}

.sub-sub-section-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 6rpx 0;
}

.sub-sub-section-num {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9CA3AF;
  min-width: 90rpx;
}

.sub-sub-section-text {
  flex: 1;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.6;
}

/* 名词定义 */
.glossary-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.glossary-item {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.glossary-item:last-child {
  border-bottom: none;
}

.glossary-term {
  flex-shrink: 0;
  width: 180rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0052D9;
}

.glossary-def {
  flex: 1;
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
}

/* 空状态 */
.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #9CA3AF;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
}

/* 底部信息 */
.footer-info {
  margin-top: 60rpx;
  padding: 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.footer-date {
  font-size: 22rpx;
  color: #D1D5DB;
}

/* 目录抽屉 */
.toc-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.toc-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 70vw;
  height: 100vh;
  background: #FFFFFF;
  z-index: 201;
  display: flex;
  flex-direction: column;
  animation: slideIn 0.2s ease-out;
  box-sizing: border-box;
}

@keyframes slideIn {
  from { transform: translateX(100%); }
  to { transform: translateX(0); }
}

.toc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.toc-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.toc-close {
  font-size: 40rpx;
  color: #9CA3AF;
  padding: 0 8rpx;
}

.toc-scroll {
  flex: 1;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.toc-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F9FAFB;
  transition: background 0.15s ease;
}

.toc-item:active {
  background: #F9FAFB;
}

.toc-item.active {
  background: #ECF2FE;
  border-left: 6rpx solid #0052D9;
  padding-left: 22rpx;
}

.toc-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #0052D9;
  min-width: 50rpx;
}

.toc-item.active .toc-num {
  color: #0052D9;
}

.toc-text {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.toc-item.active .toc-text {
  color: #0052D9;
  font-weight: 600;
}
