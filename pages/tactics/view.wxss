.view-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100%;
  background: #F5F5F7;
  overflow: hidden;
  box-sizing: border-box;
}

/* ===== 顶部栏 ===== */
.top-bar {
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  padding-right: 16rpx;
  padding-bottom: 10rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F2F4F7;
  flex-shrink: 0;
}

.top-left {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.back-icon {
  font-size: 40rpx;
  color: #101828;
  font-weight: 300;
}

.top-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #101828;
}

.top-right {
  width: 56rpx;
  flex-shrink: 0;
}

/* ===== 中央状态 ===== */
.center-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx;
}

.spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E5E7EB;
  border-top-color: #0052D9;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-icon {
  font-size: 80rpx;
}

.state-text {
  font-size: 30rpx;
  color: #374151;
  font-weight: 600;
  text-align: center;
}

.state-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  text-align: center;
}

.retry-btn {
  margin-top: 16rpx;
  background: #0052D9;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
}

.retry-btn::after {
  border: none;
}

.retry-btn:active {
  opacity: 0.85;
}
