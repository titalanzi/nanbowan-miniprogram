/* ===== Banner 轮播 ===== */

.banner {
  position: relative;
  width: 100%;
  height: 280rpx;
  margin-bottom: 24rpx;
}

.banner-swiper-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
  margin-bottom: 24rpx;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

/* 自定义指示点 */
.banner-dots {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.25s ease;
}

.dot.active {
  width: 28rpx;
  border-radius: 6rpx;
  background: #FF6B35;
}

.match-creator {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 14rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.creator-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.creator-avatar.placeholder {
  background: #FF6B35;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

.creator-name {
  font-size: 26rpx;
  color: #667085;
  font-weight: 500;
}

.creator-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.vip-icon {
  width: 32rpx;
  height: 32rpx;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.match-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
}

.match-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.info-item {
  font-size: 26rpx;
  color: #667085;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.match-groups {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.group-tag {
  color: white;
  padding: 10rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.match-enter {
  text-align: right;
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

/* ===== 队训卡片样式 ===== */
.match-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.type-icon {
  font-size: 36rpx;
  flex-shrink: 0;
}

.training-card {
  border-left: 8rpx solid #8B5CF6;
  padding-left: 24rpx;
}

.training-placeholder {
  background: linear-gradient(135deg, #8B5CF6, #6366F1) !important;
}

.tag-training {
  background: #F3F0FF;
  color: #8B5CF6;
}

.coach-info {
  font-size: 24rpx;
  color: #8B5CF6;
  margin-top: 6rpx;
  font-weight: 500;
}

.training-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #F5F3FF, #FFFFFF);
  border-radius: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

/* 签到人员头像列表 */
.attendee-avatars {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.attendee-avatar-item {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  margin-left: -12rpx;
  background: #E5E7EB;
}

.attendee-avatar-item:first-child {
  margin-left: 0;
}

.attendee-avatar-item.hidden {
  display: none;
}

.attendee-avatar-more {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 600;
}

