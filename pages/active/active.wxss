.page {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
  background: #F3F4F7;
}

/* 骨架屏 */
.skeleton {
  padding: 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

/* Banner 轮播 */
.banner-wrap {
  position: relative;
  width: 100%;
  height: 280rpx;
  margin-bottom: 24rpx;
}

.banner {
  width: 100%;
  height: 100%;
}

.banner-img {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.banner-dots {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.25s ease;
}

.dot.active {
  width: 28rpx;
  border-radius: 6rpx;
  background: #0052D9;
}

/* 快捷功能入口 */
.quick {
  display: flex;
  justify-content: space-between;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.04);
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #ECF2FE;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick-label {
  font-size: 22rpx;
  color: #475467;
  font-weight: 500;
}

/* 列表 */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.04);
  position: relative;
  transition: transform 0.15s ease;
}

.card:active {
  transform: scale(0.985);
}

.train-card {
  border-left: 8rpx solid #0052D9;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #101828;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.creator {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 12rpx 16rpx;
  background: #F7F8FA;
  border-radius: 14rpx;
}

.creator-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.creator-name {
  font-size: 26rpx;
  color: #475467;
  font-weight: 500;
}

.coach-tag {
  font-size: 22rpx;
  color: #0052D9;
  background: #ECF2FE;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.card-info {
  display: flex;
  gap: 28rpx;
  margin-bottom: 16rpx;
}

.info {
  font-size: 26rpx;
  color: #667085;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.groups {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.group {
  color: #FFFFFF;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.enter {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.enter-link {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: #0052D9;
  font-size: 28rpx;
  font-weight: 600;
}
