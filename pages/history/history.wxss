.match-creator {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #F2F6FF, #FFFFFF);
  border-radius: 16rpx;
}

.creator-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.creator-avatar.placeholder {
  background: linear-gradient(135deg, #0052D9, #366EF4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: white;
  font-size: 32rpx;
  font-weight: 700;
}

.creator-name {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}

.creator-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.vip-icon {
  width: 36rpx;
  height: 36rpx;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.match-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.match-info {
  display: flex;
  gap: 28rpx;
  margin-bottom: 24rpx;
}

.info-item {
  font-size: 28rpx;
  color: #6B7280;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.match-groups {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.group-tag {
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.match-enter {
  text-align: right;
  font-size: 30rpx;
  color: #6B7280;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.card:active .match-enter {
  color: #0052D9;
}

/* ============ Tab 切换栏 ============ */
.tabs-wrapper {
  background: white;
  padding: 20rpx;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.tabs {
  display: flex;
  gap: 16rpx;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx;
  background: #F3F4F6;
  border-radius: 20rpx;
  gap: 8rpx;
  transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
}

.tab.active {
  background: linear-gradient(135deg, #0052D9, #366EF4);
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.35);
  transform: translateY(-2rpx);
}

.tab-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  letter-spacing: 2rpx;
}

.tab.active .tab-name {
  color: white;
  font-weight: 700;
}

.tab-indicator {
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: white;
  box-shadow: 0 2rpx 6rpx rgba(255, 255, 255, 0.8);
}

/* ============ 队训卡片样式 ============ */
.training-card {
  border-left: 8rpx solid #0052D9;
  padding-left: 24rpx;
}

.training-placeholder {
  background: linear-gradient(135deg, #366EF4, #618DFF) !important;
}

.coach-info {
  font-size: 24rpx;
  color: #0052D9;
  margin-top: 6rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.match-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.training-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

/* 签到人员头像列表 */
.attendee-avatars {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.attendee-avatar-item {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  margin-left: -12rpx;
  background: #E5E7EB;
}

.attendee-avatar-item:first-child {
  margin-left: 0;
}

.attendee-avatar-item.hidden {
  display: none;
}

.attendee-avatar-more {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 600;
}

/* ============ 加载状态 ============ */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.load-more-area {
  padding: 32rpx 0 48rpx;
  display: flex;
  justify-content: center;
}

.load-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #9CA3AF;
}

.load-tip.ended {
  color: #D1D5DB;
  letter-spacing: 2rpx;
}

.load-more-btn {
  background: transparent !important;
  border-color: #0052D9 !important;
  color: #0052D9 !important;
}
