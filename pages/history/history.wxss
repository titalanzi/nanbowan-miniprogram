.match-creator {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #F3F4F6, #FFFFFF);
  border-radius: 16rpx;
}

.creator-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 3rpx solid white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.creator-avatar.placeholder {
  background: linear-gradient(135deg, #FF6B35, #F7931E);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: white;
  font-size: 32rpx;
  font-weight: 700;
}

.creator-name {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}

.creator-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.vip-icon {
  width: 36rpx;
  height: 36rpx;
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.match-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.match-info {
  display: flex;
  gap: 28rpx;
  margin-bottom: 24rpx;
}

.info-item {
  font-size: 28rpx;
  color: #6B7280;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.match-groups {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.group-tag {
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.match-enter {
  text-align: right;
  font-size: 30rpx;
  color: #6B7280;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.match-enter::after {
  content: '→';
  font-size: 36rpx;
  transition: transform 0.3s ease;
}

.card:active .match-enter::after {
  transform: translateX(8rpx);
}
