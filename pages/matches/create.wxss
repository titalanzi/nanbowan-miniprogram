.page-header {
  margin-bottom: 20rpx;
}

.team-selector {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.team-picker {
  flex: 1;
}

.team-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
  display: block;
}

.picker-value {
  padding: 16rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.vs-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #999;
  padding: 0 20rpx;
}

.team-members-list {
  margin-top: 16rpx;
  max-height: 200rpx;
  overflow-y: auto;
}

.member-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 8rpx;
  background: #FAFAFA;
}

.member-option.selected {
  background: rgba(255, 107, 53, 0.1);
}

.member-name {
  font-size: 26rpx;
  color: #333;
}

.member-number {
  font-size: 24rpx;
  color: #999;
}

.score-card {
  text-align: center;
}

.score-display {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.team-score {
  text-align: center;
}

.team-score .team-name {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.team-score .score {
  font-size: 64rpx;
  font-weight: 700;
  color: #FF6B35;
}

.score-vs {
  font-size: 32rpx;
  font-weight: 600;
  color: #999;
}

.timer-section {
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
}

.timer {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  font-family: monospace;
}

.timer-controls {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.timer-btn {
  font-size: 26rpx;
  color: #FF6B35;
  padding: 12rpx 24rpx;
  background: rgba(255, 107, 53, 0.1);
  border-radius: 24rpx;
}

.stat-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border: 2rpx solid #E0E0E0;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.stat-option.selected {
  background: rgba(255, 107, 53, 0.1);
}

.stat-option.add-stat {
  border-style: dashed;
  color: #999;
}

.stat-icon {
  font-size: 28rpx;
}

.stat-name {
  color: #333;
}

.add-record-btn {
  width: 100%;
}

.records-list {
  max-height: 300rpx;
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-info {
  display: flex;
  gap: 16rpx;
  font-size: 24rpx;
}

.record-time {
  color: #999;
  font-family: monospace;
}

.record-team {
  color: #FF6B35;
  font-weight: 500;
}

.record-member {
  color: #333;
}

.record-stat {
  color: #666;
}

.record-delete {
  font-size: 24rpx;
  color: #E53935;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  padding-bottom: 120rpx;
}

.action-buttons button {
  flex: 1;
}

.picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 60vh;
  overflow: hidden;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F0F0F0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
}

.picker-close {
  font-size: 48rpx;
  color: #999;
}

.picker-list {
  padding: 16rpx;
  max-height: 50vh;
  overflow-y: auto;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.picker-item.selected {
  background: rgba(255, 107, 53, 0.1);
}

.group-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}