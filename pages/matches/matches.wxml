<view class="container">
  <view class="page-header">
    <text class="page-title">比赛记录</text>
    <button class="add-btn" bindtap="goToCreateMatch">+ 新建比赛</button>
  </view>

  <view class="filter-bar">
    <view class="filter-btn" bindtap="openFilter">
      <text>🔍 {{filterGroupId ? getGroupName(filterGroupId) : '全部分组'}}</text>
    </view>
    <text class="match-count">共 {{filteredMatches.length}} 场比赛</text>
  </view>

  <view wx:if="{{filteredMatches.length === 0}}" class="empty-state">
    <text class="empty-icon">🏆</text>
    <text class="empty-text">暂无比赛记录</text>
    <text class="empty-hint">点击右上角按钮创建比赛</text>
  </view>

  <view wx:else class="match-list">
    <view 
      wx:for="{{filteredMatches}}" 
      wx:key="id" 
      class="match-card"
    >
      <view class="match-header" bindtap="viewMatchDetail" data-id="{{item.id}}">
        <view class="match-teams">
          <view class="team-box" style="border-color: {{item.groupAColor}}">
            <view class="team-color" style="background-color: {{item.groupAColor}}"></view>
            <text class="team-name">{{item.groupAName}}</text>
          </view>
          <text class="vs">VS</text>
          <view class="team-box" style="border-color: {{item.groupBColor}}">
            <view class="team-color" style="background-color: {{item.groupBColor}}"></view>
            <text class="team-name">{{item.groupBName}}</text>
          </view>
        </view>
        <view class="match-score-row">
          <view class="score-box {{item.winner === 'A' ? 'winner' : ''}}">
            <text class="score-value">{{item.groupAScore}}</text>
          </view>
          <text class="score-divider">:</text>
          <view class="score-box {{item.winner === 'B' ? 'winner' : ''}}">
            <text class="score-value">{{item.groupBScore}}</text>
          </view>
        </view>
      </view>
      <view class="match-footer">
        <view class="match-meta">
          <text class="match-date">📅 {{item.date}}</text>
          <text class="match-location">📍 {{item.location}}</text>
        </view>
        <view class="match-actions">
          <text class="action-btn" bindtap="viewMatchDetail" data-id="{{item.id}}">详情</text>
          <text class="action-btn delete" bindtap="deleteMatch" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{showFilterModal}}" class="modal-overlay" bindtap="closeFilter">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">筛选分组</text>
        <text class="modal-close" bindtap="closeFilter">×</text>
      </view>
      <view class="modal-body">
        <view 
          class="filter-option {{!filterGroupId ? 'selected' : ''}}"
          bindtap="selectFilterGroup"
          data-id=""
        >
          全部分组
        </view>
        <view 
          wx:for="{{groups}}" 
          wx:key="id"
          class="filter-option {{filterGroupId === item.id ? 'selected' : ''}}"
          bindtap="selectFilterGroup"
          data-id="{{item.id}}"
        >
          <view class="filter-color" style="background-color: {{item.color}}"></view>
          {{item.name}}
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="resetFilter">重置</button>
        <button class="btn-primary" bindtap="applyFilter">确定</button>
      </view>
    </view>
  </view>
</view>