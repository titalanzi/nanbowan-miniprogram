.match-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.back-btn {
  font-size: 48rpx;
  color: #FF6B35;
  font-weight: 300;
}

.match-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.placeholder {
  width: 60rpx;
}

.match-info-card {
  text-align: center;
}

.match-result {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.team-section {
  flex: 1;
}

.team-header {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.team-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.team-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.team-score {
  font-size: 72rpx;
  font-weight: 700;
  color: #FF6B35;
  display: block;
}

.team-stats {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.stat-badge {
  padding: 8rpx 16rpx;
  background: #FAFAFA;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.vs {
  font-size: 36rpx;
  font-weight: 700;
  color: #999;
}

.match-meta {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
}

.meta-item {
  font-size: 26rpx;
  color: #999;
}

.records-scroll {
  max-height: 500rpx;
}

.records-container {
  display: flex;
  gap: 24rpx;
}

.team-records {
  flex: 1;
}

.team-label {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid;
}

.record-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.record-row:last-child {
  border-bottom: none;
}

.record-time {
  font-size: 22rpx;
  color: #999;
  font-family: monospace;
}

.record-member {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.record-stat {
  font-size: 24rpx;
  color: #FF6B35;
}