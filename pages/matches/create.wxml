<view class="container">
  <view class="page-header">
    <text class="page-title">创建比赛</text>
  </view>

  <view class="card">
    <text class="card-title">选择队伍</text>
    <view class="team-selector">
      <view class="team-picker">
        <text class="team-label">队伍 A</text>
        <view class="picker-value" bindtap="showGroupAPicker">
          {{getGroupName(groupAId) || '请选择队伍'}}
        </view>
        <view wx:if="groupAId" class="team-members-list">
          <view 
            wx:for="{{groupAMembers}}" 
            wx:key="id"
            class="member-option {{selectedTeam === 'A' && selectedMemberId === item.id ? 'selected' : ''}}"
            bindtap="selectTeam"
            data-team="A"
          >
            <text class="member-name">{{item.name}}</text>
          </view>
        </view>
      </view>
      <text class="vs-text">VS</text>
      <view class="team-picker">
        <text class="team-label">队伍 B</text>
        <view class="picker-value" bindtap="showGroupBPicker">
          {{getGroupName(groupBId) || '请选择队伍'}}
        </view>
        <view wx:if="groupBId" class="team-members-list">
          <view 
            wx:for="{{groupBMembers}}" 
            wx:key="id"
            class="member-option {{selectedTeam === 'B' && selectedMemberId === item.id ? 'selected' : ''}}"
            bindtap="selectTeam"
            data-team="B"
          >
            <text class="member-name">{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="card score-card">
    <view class="score-display">
      <view class="team-score">
        <text class="team-name">{{getGroupName(groupAId) || '-'}}</text>
        <text class="score">{{currentScoreA}}</text>
      </view>
      <text class="score-vs">VS</text>
      <view class="team-score">
        <text class="team-name">{{getGroupName(groupBId) || '-'}}</text>
        <text class="score">{{currentScoreB}}</text>
      </view>
    </view>
    <view class="timer-section">
      <text class="timer">{{formatTime(timeElapsed)}}</text>
      <view class="timer-controls">
        <text class="timer-btn" bindtap="startTimer">{{timerInterval ? '暂停' : '开始'}}</text>
        <text class="timer-btn" bindtap="resetTimer">重置</text>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">记录统计</text>
    <view class="stat-selector">
      <view 
        wx:for="{{customStats}}" 
        wx:key="id"
        class="stat-option {{currentStatType === item.id ? 'selected' : ''}}"
        style="border-color: {{item.color}}"
        bindtap="selectStatType"
        data-type="{{item.id}}"
      >
        <text class="stat-icon">{{item.icon}}</text>
        <text class="stat-name">{{item.name}}</text>
      </view>
      <view class="stat-option add-stat" bindtap="showAddStatModal">
        <text class="stat-icon">+</text>
        <text class="stat-name">添加</text>
      </view>
    </view>
    
    <button class="btn-primary add-record-btn" bindtap="addRecord">
      + 记录{{getStatName(currentStatType)}}
    </button>
  </view>

  <view class="card">
    <text class="card-title">比赛记录</text>
    <scroll-view class="records-list" scroll-y>
      <view wx:if="{{records.length === 0}}" class="empty-state small">
        <text class="empty-icon">📝</text>
        <text class="empty-text">暂无记录</text>
      </view>
      <view 
        wx:for="{{records}}" 
        wx:key="id" 
        class="record-item"
      >
        <view class="record-info">
          <text class="record-time">{{item.time}}</text>
          <text class="record-team">队伍{{item.team}}</text>
          <text class="record-member">{{item.memberName}}</text>
          <text class="record-stat">{{item.typeName}}</text>
        </view>
        <text class="record-delete" bindtap="removeRecord" data-id="{{item.id}}">删除</text>
      </view>
    </scroll-view>
  </view>

  <view class="card">
    <text class="card-title">比赛信息</text>
    <view class="form-item">
      <text class="form-label">日期</text>
      <picker mode="date" value="{{matchDate}}" bindchange="onDateChange">
        <view class="picker-container">{{matchDate}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="form-label">地点</text>
      <input class="form-input" placeholder="请输入比赛地点" value="{{matchLocation}}" bindinput="onLocationInput" />
    </view>
  </view>

  <view class="action-buttons">
    <button class="btn-secondary" bindtap="cancelMatch">取消</button>
    <button class="btn-primary" bindtap="finishMatch">结束比赛</button>
  </view>

  <view wx:if="{{showStatModal}}" class="modal-overlay" bindtap="closeStatModal">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">添加统计项</text>
        <text class="modal-close" bindtap="closeStatModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">统计项名称</text>
          <input class="form-input" placeholder="如：拦截、失误" value="{{newStatName}}" bindinput="onNewStatNameInput" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="closeStatModal">取消</button>
        <button class="btn-primary" bindtap="addCustomStat">添加</button>
      </view>
    </view>
  </view>

  <view class="picker-overlay" wx:if="showGroupAPicker">
    <view class="picker-content">
      <view class="picker-header">
        <text class="picker-title">选择队伍 A</text>
        <text class="picker-close" bindtap="showGroupAPicker">×</text>
      </view>
      <view class="picker-list">
        <view 
          wx:for="{{groups}}" 
          wx:key="id"
          class="picker-item {{groupAId === item.id ? 'selected' : ''}}"
          bindtap="selectGroupA"
          data-id="{{item.id}}"
        >
          <view class="group-color" style="background-color: {{item.color}}"></view>
          {{item.name}}
        </view>
      </view>
    </view>
  </view>

  <view class="picker-overlay" wx:if="showGroupBPicker">
    <view class="picker-content">
      <view class="picker-header">
        <text class="picker-title">选择队伍 B</text>
        <text class="picker-close" bindtap="showGroupBPicker">×</text>
      </view>
      <view class="picker-list">
        <view 
          wx:for="{{groups}}" 
          wx:key="id"
          class="picker-item {{groupBId === item.id ? 'selected' : ''}}"
          bindtap="selectGroupB"
          data-id="{{item.id}}"
        >
          <view class="group-color" style="background-color: {{item.color}}"></view>
          {{item.name}}
        </view>
      </view>
    </view>
  </view>
</view>