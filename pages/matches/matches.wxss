.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.add-btn {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: white;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-btn {
  background: white;
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.match-count {
  font-size: 24rpx;
  color: #999;
}

.match-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.match-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.match-header {
  padding: 24rpx;
}

.match-teams {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.team-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid;
}

.team-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.team-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.vs {
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
  padding: 0 16rpx;
}

.match-score-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}

.score-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
}

.score-box.winner {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
}

.score-box.winner .score-value {
  color: white;
}

.score-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}

.score-divider {
  font-size: 36rpx;
  color: #999;
  font-weight: 600;
}

.match-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #FAFAFA;
}

.match-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #999;
}

.match-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #FF6B35;
}

.action-btn.delete {
  color: #E53935;
}

.filter-option {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  background: #FAFAFA;
  font-size: 28rpx;
}

.filter-option.selected {
  background: rgba(255, 107, 53, 0.1);
  color: #FF6B35;
}

.filter-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}