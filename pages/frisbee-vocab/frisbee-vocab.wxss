.container {
  padding: 20rpx 24rpx 40rpx;
  background: #F7F8FA;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 38rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #98A2B3;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
  height: 100%;
}

.clear-icon {
  font-size: 24rpx;
  color: #98A2B3;
  padding: 12rpx;
}

/* 词汇列表 */
.vocab-list {
  padding-top: 96rpx;
  padding-right: 60rpx;
}

.letter-section {
  margin-bottom: 24rpx;
}

.letter-header {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF6B35;
  padding: 16rpx 0;
}

.word-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.word-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.word-item:last-child {
  border-bottom: none;
}

.word-main {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding-right: 16rpx;
}

.word-en {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.word-cn {
  font-size: 28rpx;
  color: #6B7280;
}

.info-icon {
  font-size: 26rpx;
  color: #FF6B35;
  padding: 4rpx 8rpx;
}

.play-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #FFF3ED;
  transition: all 0.2s;
}

.play-btn.playing {
  background: #FF6B35;
}

.play-icon {
  font-size: 30rpx;
  color: #FF6B35;
}

.play-btn.playing .play-icon {
  color: #FFFFFF;
}

/* 右侧字母索引 */
.letter-index {
  position: fixed;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 6rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.index-item {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #6B7280;
  border-radius: 50%;
  margin: 2rpx 0;
}

.index-item.active {
  color: #FFFFFF;
  background: #FF6B35;
}

/* 说明弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  font-size: 40rpx;
  color: #9CA3AF;
  padding: 0 8rpx;
}

.modal-body {
  padding: 28rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.note-text {
  font-size: 30rpx;
  color: #4B5563;
  line-height: 1.6;
}

/* 无结果提示 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}
