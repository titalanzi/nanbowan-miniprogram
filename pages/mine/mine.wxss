/* ===== 新用户注册 ===== */
.register-page {
  padding-bottom: 60rpx;
}

/* 品牌头部（全幅渐变） */
.reg-hero {
  position: relative;
  margin: -20rpx -20rpx 0;
  padding: 76rpx 40rpx 100rpx;
  background: linear-gradient(135deg, #366EF4 0%, #0052D9 55%, #1A4FBE 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  overflow: hidden;
}

.reg-hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.reg-hero-deco-1 {
  width: 300rpx;
  height: 300rpx;
  right: -90rpx;
  top: -120rpx;
}

.reg-hero-deco-2 {
  width: 180rpx;
  height: 180rpx;
  left: -60rpx;
  bottom: -80rpx;
  background: rgba(255, 255, 255, 0.08);
}

.reg-hero-badge {
  position: relative;
  z-index: 2;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.7);
  display: block;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.reg-hero-title {
  position: relative;
  z-index: 2;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.reg-hero-sub {
  position: relative;
  z-index: 2;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 信息卡片（上移覆盖头部，形成层叠） */
.reg-card {
  position: relative;
  z-index: 3;
  margin: -56rpx 24rpx 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 44rpx 32rpx 32rpx;
  box-shadow: 0 10rpx 36rpx rgba(16, 24, 40, 0.08);
}

.reg-field {
  margin-bottom: 36rpx;
}

/* 头像区：居中，整体可点 */
.reg-avatar-field {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 44rpx;
}

.reg-avatar-field .form-label {
  align-self: flex-start;
  margin-bottom: 20rpx;
}

.reg-avatar-btn {
  margin: 0;
  padding: 0;
  line-height: normal;
  background: transparent;
  border: none;
}

.reg-avatar-btn::after {
  border: none;
}

.reg-avatar {
  position: relative;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #0052D9;
  box-shadow: 0 10rpx 26rpx rgba(0, 82, 217, 0.24);
}

.reg-avatar-img {
  width: 100%;
  height: 100%;
}

.reg-avatar-ph {
  width: 100%;
  height: 100%;
  display: block;
}

.reg-avatar-tip {
  font-size: 24rpx;
  color: #98A2B3;
  margin-top: 16rpx;
}

/* 提交按钮 */
.reg-submit {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0;
  border-radius: 46rpx;
  font-size: 32rpx;
  margin-top: 8rpx;
  background: linear-gradient(135deg, #366EF4, #0052D9);
  box-shadow: 0 8rpx 24rpx rgba(0, 82, 217, 0.32);
}

/* 未勾选协议时的视觉提示（按钮仍可点击，点击会明确提示原因） */
.reg-submit-hint {
  opacity: 0.55;
}

/* 协议勾选：默认不勾选，由用户主动勾选 */
.reg-agreement {
  margin-top: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: flex-start;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.5;
}

.agree-checkbox {
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 2rpx solid #D0D5DD;
  border-radius: 8rpx;
  background: #FFFFFF;
  flex-shrink: 0;
  margin-top: 2rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.agree-checkbox.is-checked {
  background: #0052D9;
  border-color: #0052D9;
}

.agree-checkbox-mark {
  width: 10rpx;
  height: 18rpx;
  border: 3rpx solid #FFFFFF;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg) translate(-2rpx, -2rpx);
  opacity: 0;
}

.agree-checkbox.is-checked .agree-checkbox-mark {
  opacity: 1;
}

.agree-text {
  flex: 1;
}

.reg-agreement-link {
  color: #0052D9;
}

.reg-ph {
  color: #B0B7C3;
}

.avatar-pick-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.avatar-preview {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #0052D9;
  box-shadow: 0 8rpx 20rpx rgba(0, 82, 217, 0.18);
}

.avatar-placeholder {
  font-size: 64rpx;
  color: #98A2B3;
  font-weight: 300;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-pick-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  width: 100%;
}

.wx-btn {
  margin: 0;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #0052D9, #366EF4);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 36rpx;
  box-shadow: 0 8rpx 18rpx rgba(0, 82, 217, 0.28);
  transition: all 0.15s ease;
}

.wx-btn::after {
  border: none;
}

.wx-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.album-link {
  font-size: 26rpx;
  color: #0052D9;
  font-weight: 500;
  padding: 8rpx 0;
}

.album-link:active {
  opacity: 0.6;
}

.avatar-tip {
  font-size: 24rpx;
  color: #98A2B3;
  text-align: center;
}

.user-card {
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.edit-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #F2F4F7;
  transition: all 0.2s ease;
}

.edit-btn:active {
  background: #F2F4F7;
}

.edit-icon {
  font-size: 28rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background-size: cover;
  background-position: center;
  border: 3rpx solid #0052D9;
}

.user-avatar-img {
  width: 100%;
  height: 100%;
}

.user-avatar-placeholder {
  font-size: 60rpx;
}

.user-detail {
  flex: 1;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #101828;
  display: block;
  margin-bottom: 10rpx;
}

.user-id {
  font-size: 24rpx;
  color: #98A2B3;
  display: block;
  margin-bottom: 12rpx;
}

.user-role {
  margin-top: 8rpx;
}

.role-tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.role-tag.normal {
  background: #F2F4F7;
  color: #667085;
}

.role-tag.assistant {
  background: #FEF3F2;
  color: #B42318;
}

.action-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  transition: all 0.2s ease;
}

.action-card:active {
  background: #F9FAFB;
}

.action-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F9FAFB;
  border-radius: 16rpx;
}

/* 性别选择（等宽卡片） */
.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
  border: 2rpx solid #E4E7EC;
  transition: all 0.2s ease;
}

.gender-option.active {
  background: #ECF2FE;
  border-color: #0052D9;
  box-shadow: 0 4rpx 14rpx rgba(0, 82, 217, 0.16);
}

.gender-icon {
  width: 40rpx;
  height: 40rpx;
}

.gender-option text {
  font-size: 30rpx;
  color: #475467;
}

.gender-option.active text {
  color: #0052D9;
  font-weight: 600;
}

.action-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #101828;
}

.action-arrow {
  font-size: 32rpx;
  color: #D0D5DD;
}

.register-hint {
  background: #ECF2FE;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #D4E2FB;
}

.hint-text {
  font-size: 26rpx;
  color: #1A4FBE;
  text-align: center;
  display: block;
  font-weight: 500;
}
